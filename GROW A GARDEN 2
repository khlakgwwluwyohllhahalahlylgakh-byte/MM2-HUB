-- 3. MUTASYON VE HAVA DURUMU SİSTEMİ (MUTATION TAB)
--------------------------------------------------------------------------------

TabMut:CreateSection("Bloodlit (80x) & Electric (70x) Mutasyon Takibi")

-- Nadir Mutasyon Mahsul ESP (Bloodlit, Electric, Gold, Rainbow)
TabMut:CreateToggle({
    Name = "Yüksek Çarpanlı Mutasyon Mahsul ESP (Yeşil/Altın)",
    CurrentValue = false,
    Callback = function(Value)
        _G.MutationESP = Value
        task.spawn(function()
            while _G.MutationESP do
                task.wait(1)
                pcall(function()
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        local name = obj.Name:lower()
                        if name:find("bloodlit") or name:find("electric") or name:find("rainbow") or name:find("gold") then
                            if not obj:FindFirstChild("Highlight") then
                                local hl = Instance.new("Highlight", obj)
                                hl.FillColor = Color3.fromRGB(255, 215, 0) -- Altın sarısı
                                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            end
                        end
                    end
                end)
            end
        end)
    end,
})

-- Sprinkler Size Luck Optimizasyon Bilgisi (100 Sınırı)
TabMut:CreateButton({
    Name = "💧 Sprinkler Size Luck Bilgi Bildirimi",
    Callback = function()
        Rayfield:Notify({Title = "Size Luck Sınırı", Content = "Aktif yağmurlamalar 100 sınırındadır! Fazlası ekstra bonus vermez.", Duration = 5})
    end,
})

