TabWorld:CreateSection("Karakter ve Hız Kontrolleri")

TabWorld:CreateToggle({
    Name = "Süper Koşma Hızı (WalkSpeed 48)",
    CurrentValue = false,
    Callback = function(Value)
        _G.SuperSpeed = Value
        task.spawn(function()
            while _G.SuperSpeed do
