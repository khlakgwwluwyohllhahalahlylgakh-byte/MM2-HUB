local isCheatActive = false

-- ==========================================
-- GÜVENLİ TEMİZLİK (FULL CLEANUP)
-- ==========================================
local function FullCleanup()
    _G.AutoHarvest = false
    _G.NightThiefESP = false
    _G.DefenseAura = false
    _G.MutationESP = false
    _G.SuperSpeed = false
    _G.GodMode = false

    -- Oyuncu ve Dünya üzerindeki Highlight/ESP kalıntılarını temizle
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local hl = p.Character:FindFirstChildOfClass("Highlight")
            if hl then hl:Destroy() end
        end
    end
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local hl = obj:FindFirstChildOfClass("Highlight")
        if hl then hl:Destroy() end
    end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = 16
    end
end

-- Rayfield UI Kütüphanesini Güvenli Yükleme
local Success, Rayfield = pcall(function()
    return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)

if not Success or not Rayfield then
    warn("Rayfield UI yüklenemedi!")
    return
end

local Window = Rayfield:CreateWindow({
    Name = "🌱 Grow a Garden 2 | Omega System Hub",
    LoadingTitle = "GAG2 Sistem Dökümü Yükleniyor...",
    LoadingSubtitle = "Stock, Mutasyon & Gece Çalma Mekanikleri Entegre Edildi",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "GAG2OmegaHub",
        FileName = "MasterConfig"
