    Name = "Ölümsüzlük (GodMode)",
    CurrentValue = false,
    Callback = function(Value)
        _G.GodMode = Value
        task.spawn(function()
            while _G.GodMode do
                task.wait(0.05)
                pcall(function()
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("Humanoid") then
                        char.Humanoid.Health = char.Humanoid.MaxHealth
                    end
                end)
            end
        end)
    end,
})

