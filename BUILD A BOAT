-- 🚀 ANA MOTOR (RenderStepped & Heartbeat)
-- ==========================================================
RunService.RenderStepped:Connect(function(dt)
    if _G.GodPrimeBABFT.Noclip and Character then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    local root = Character and Character:FindFirstChild("HumanoidRootPart")
    local hum = Character and Character:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    if _G.GodPrimeBABFT.MobileFly then
        hum.PlatformStand = true
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    else
        hum.PlatformStand = false
    end

    hum.WalkSpeed = _G.GodPrimeBABFT.Speed
    hum.JumpPower = _G.GodPrimeBABFT.JumpPower

    if _G.GodPrimeBABFT.AutoFarm and not _G.GodPrimeBABFT.MobileFly then
        pcall(function()
            local targetPos = Vector3.new(-50, 70, 9465)
            local currentPos = root.Position
            local distance = (currentPos - targetPos).Magnitude

            if distance > 15 then
                local direction = (targetPos - currentPos).Unit
                local step = direction * math.min(_G.GodPrimeBABFT.FlightSpeed * dt, distance)
                root.CFrame = CFrame.new(currentPos + step, targetPos)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            else
                if _G.GodPrimeBABFT.AutoCollectChest then
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if obj.Name == "TreasureChest" or obj.Name == "GoldChest" then
                            local part = obj:FindFirstChildWhichIsA("BasePart")
                            if part then
                                root.CFrame = part.CFrame * CFrame.new(0, 4, 0)
                                task.wait(0.6)
                                break
                            end
                        end
                    end
                end
                
                task.wait(_G.GodPrimeBABFT.FarmDelay)
                root.CFrame = CFrame.new(-50, 50, -60)
                task.wait(2)
            end
        end)
    end

    if _G.GodPrimeBABFT.AntiVoid and root.Position.Y < -50 then
        root.CFrame = CFrame.new(-50, 100, -60)
    end
end)

RunService.Heartbeat:Connect(function()
    if _G.GodPrimeBABFT.BoatGodMode and CurrentBoat then
        for _, part in ipairs(CurrentBoat:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
    
    if _G.GodPrimeBABFT.AutoRepairBoat and CurrentBoat then
        for _, part in ipairs(CurrentBoat:GetDescendants()) do
            if part:IsA("BasePart") and part.Transparency > 0 then
                part.Transparency = 0
            end
        end
    end
end)

