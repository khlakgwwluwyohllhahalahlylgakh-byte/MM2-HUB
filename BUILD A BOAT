local function addBoatESP(boat)
    if not boat:FindFirstChild("BabftBoatESP") then
        local hl = Instance.new("Highlight")
        hl.Name = "BabftBoatESP"
        hl.FillColor = Color3.fromRGB(0, 200, 255)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.6
        hl.Parent = boat
    end
end

local function toggleChestESP(state)
    _G.GodPrimeBABFT.ChestESP = state
    if state then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == "TreasureChest" or obj.Name == "GoldChest" then addChestESP(obj) end
        end
    else
        for _, obj in ipairs(Workspace:GetDescendants()) do
            local esp = obj:FindFirstChild("BabftChestESP") or obj:FindFirstChild("ChestTag")
            if esp then esp:Destroy() end
        end
    end
end

local function toggleBoatESP(state)
    _G.GodPrimeBABFT.BoatESP = state
    if state then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and (obj:FindFirstChild("Seat") or obj:FindFirstChild("Shipyard")) then addBoatESP(obj) end
        end
    else
        for _, obj in ipairs(Workspace:GetDescendants()) do
            local esp = obj:FindFirstChild("BabftBoatESP")
            if esp then esp:Destroy() end
        end
    end
end

local function toggleXRay(state)
    _G.GodPrimeBABFT.XRay = state
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(Character) then
            obj.Transparency = state and 0.6 or 0
        end
    end
end

Workspace.DescendantAdded:Connect(function(obj)
    if _G.GodPrimeBABFT.ChestESP and (obj.Name == "TreasureChest" or obj.Name == "GoldChest") then
        addChestESP(obj)
    end
    if _G.GodPrimeBABFT.BoatESP and obj:IsA("Model") and obj:FindFirstChild("Seat") then
        addBoatESP(obj)
    end
end)

local function toggleFullbright(state)
    _G.GodPrimeBABFT.Fullbright = state
    if state then
        Lighting.Brightness = 3
