-- Karakter ve Tekne Yönetimi
local function updateCharacter(char)
    Character = char
    HumanoidRootPart = char:WaitForChild("HumanoidRootPart", 5)
    Humanoid = char:WaitForChild("Humanoid", 5)
    if Humanoid then
        Camera.CameraSubject = Humanoid
    end
    
    task.spawn(function()
        task.wait(1.5)
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and (obj:FindFirstChild("Seat") or obj:FindFirstChild("Shipyard")) then
                local weld = obj:FindFirstChildWhichIsA("Weld") or obj:FindFirstChildWhichIsA("Motor6D")
                if weld and (weld.Part0 == HumanoidRootPart or weld.Part1 == HumanoidRootPart or obj:IsAncestorOf(Character)) then
                    CurrentBoat = obj
                    break
                end
            end
        end
    end)
end

