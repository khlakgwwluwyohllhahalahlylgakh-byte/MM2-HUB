local function createMobileControls()
    if not UserInputService.TouchEnabled then return end
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "GodPrimeBABFTMobile"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    
    local joystickBase = Instance.new("Frame")
    joystickBase.Name = "JoystickBase"
    joystickBase.Size = UDim2.new(0, 120, 0, 120)
    joystickBase.Position = UDim2.new(0, 20, 1, -140)
    joystickBase.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    joystickBase.BackgroundTransparency = 0.4
    joystickBase.BorderSizePixel = 0
    joystickBase.Parent = screenGui
    
    local joystickCorner = Instance.new("UICorner")
    joystickCorner.CornerRadius = UDim.new(1, 0)
    joystickCorner.Parent = joystickBase
    
    local joystickStick = Instance.new("Frame")
    joystickStick.Name = "JoystickStick"
    joystickStick.Size = UDim2.new(0, 50, 0, 50)
    joystickStick.Position = UDim2.new(0.5, -25, 0.5, -25)
    joystickStick.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    joystickStick.BackgroundTransparency = 0.2
    joystickStick.BorderSizePixel = 0
    joystickStick.Parent = joystickBase
    
    local stickCorner = Instance.new("UICorner")
    stickCorner.CornerRadius = UDim.new(1, 0)
    stickCorner.Parent = joystickStick
    
    local buttonFrame = Instance.new("Frame")
    buttonFrame.Name = "ActionButtons"
    buttonFrame.Size = UDim2.new(0, 200, 0, 200)
    buttonFrame.Position = UDim2.new(1, -220, 1, -220)
    buttonFrame.BackgroundTransparency = 1
    buttonFrame.Parent = screenGui
    
    local function createActionButton(name, pos, color, callback)
        local btn = Instance.new("TextButton")
        btn.Name = name
        btn.Size = UDim2.new(0, 60, 0, 60)
        btn.Position = pos
        btn.BackgroundColor3 = color
        btn.BackgroundTransparency = 0.2
        btn.Text = name
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 13
        btn.Font = Enum.Font.GothamBold
        btn.BorderSizePixel = 0
        btn.Parent = buttonFrame
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = btn
        
        btn.MouseButton1Click:Connect(callback)
        return btn
    end
    
    createActionButton("FLY", UDim2.new(0, 0, 0, 0), Color3.fromRGB(0, 150, 255), function()
        _G.GodPrimeBABFT.MobileFly = not _G.GodPrimeBABFT.MobileFly
    end)
    
    createActionButton("JUMP", UDim2.new(0, 70, 0, 0), Color3.fromRGB(255, 150, 0), function()
        if Humanoid then Humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)
    
    createActionButton("NOCLIP", UDim2.new(0, 140, 0, 0), Color3.fromRGB(150, 0, 255), function()
        _G.GodPrimeBABFT.Noclip = not _G.GodPrimeBABFT.Noclip
    end)
    
    createActionButton("FARM", UDim2.new(0, 0, 0, 70), Color3.fromRGB(0, 255, 0), function()
        _G.GodPrimeBABFT.AutoFarm = not _G.GodPrimeBABFT.AutoFarm
    end)
    
    createActionButton("ESP", UDim2.new(0, 70, 0, 70), Color3.fromRGB(255, 255, 0), function()
        _G.GodPrimeBABFT.ChestESP = not _G.GodPrimeBABFT.ChestESP
        _G.GodPrimeBABFT.BoatESP = not _G.GodPrimeBABFT.BoatESP
    end)
    
    createActionButton("END", UDim2.new(0, 140, 0, 70), Color3.fromRGB(255, 50, 50), function()
        if HumanoidRootPart then HumanoidRootPart.CFrame = CFrame.new(-50, 50, 9465) end
    end)
    
    local joystickActive = false
    local joystickCenter = Vector2.new()
    
    joystickBase.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            joystickActive = true
            joystickCenter = Vector2.new(joystickBase.AbsolutePosition.X + 60, joystickBase.AbsolutePosition.Y + 60)
        end
    end)
    
    joystickBase.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            joystickActive = false
            joystickStick.Position = UDim2.new(0.5, -25, 0.5, -25)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch and joystickActive then
            local touchPos = Vector2.new(input.Position.X, input.Position.Y)
            local diff = touchPos - joystickCenter
            local maxDist = 60
            
            if diff.Magnitude > maxDist then
                diff = diff.Unit * maxDist
            end
            
            joystickStick.Position = UDim2.new(0, 35 + diff.X, 0, 35 + diff.Y)
            
            if _G.GodPrimeBABFT.MobileFly and HumanoidRootPart then
                local moveVector = Vector3.new(diff.X / maxDist, 0, diff.Y / maxDist)
                local cameraRight = Camera.CFrame.RightVector
                local cameraForward = Camera.CFrame.LookVector
                local direction = (cameraForward * moveVector.Z) + (cameraRight * moveVector.X)
                if direction.Magnitude > 0 then
                    direction = direction.Unit
                    HumanoidRootPart.AssemblyLinearVelocity = direction * _G.GodPrimeBABFT.FlySpeed
                end
            end
        end
    end)
end

