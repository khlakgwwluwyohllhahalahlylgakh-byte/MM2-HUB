-- 🧹 GÜVENLİ TEMİZLİK (FULL CLEANUP)
-- ==========================================================
local ESP_Cache = {}

local function CleanESP()
    for obj, bill in pairs(ESP_Cache) do
        if not obj or not obj.Parent then
            bill:Destroy()
            ESP_Cache[obj] = nil
        end
    end
end

local function FullCleanup()
    _G.GodSettings.KillAura = false
    _G.GodSettings.AutoFarmLevel = false
    _G.GodSettings.FruitSniper = false
    _G.GodSettings.Fly = false
    _G.GodSettings.Noclip = false
    _G.GodSettings.ESP_Players = false
    _G.GodSettings.ESP_Fruits = false
    _G.GodSettings.ESP_Chests = false
    CleanESP()
    if Character and Humanoid then
        Humanoid.WalkSpeed = 16
    end
end

