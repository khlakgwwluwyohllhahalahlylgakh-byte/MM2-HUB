-- ⚔️ SAVAŞ VE KILL AURA MOTORU
-- ==========================================================
local CombatEngine = {}

function CombatEngine:RunKillAura()
    if not _G.GodSettings.KillAura then return end
    for _, enemy in ipairs(Workspace:GetChildren()) do
        if enemy:FindFirstChild("Humanoid") and enemy:FindFirstChild("HumanoidRootPart") and enemy ~= Character then
            local hum = enemy.Humanoid
            local hrp = enemy.HumanoidRootPart
            if hum.Health > 0 and (HumanoidRootPart.Position - hrp.Position).Magnitude <= _G.GodSettings.KillAuraRange then
                pcall(function()
                    ReplicatedStorage.RemoteEvent:FireServer("Attack", enemy)
                end)
            end
        end
    end
end

-- ==========================================================
-- 🍌 MEYVE VE TARIM MOTORU
-- ==========================================================
local FarmEngine = {}

function FarmEngine:TweenTo(targetPos)
    local dist = (HumanoidRootPart.Position - targetPos).Magnitude
    local speed = 350
    local info = TweenInfo.new(dist / speed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(HumanoidRootPart, info, {CFrame = CFrame.new(targetPos + Vector3.new(0, 10, 0))})
    tween:Play()
    return tween
end

function FarmEngine:SniperFruits()
    if not _G.GodSettings.FruitSniper then return end
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj.Name:match("Fruit") and obj:FindFirstChild("Handle") then
            FarmEngine:TweenTo(obj.Handle.Position)
            task.wait(0.2)
            ReplicatedStorage.RemoteEvent:FireServer("Collect", obj.Name)
        end
    end
end

