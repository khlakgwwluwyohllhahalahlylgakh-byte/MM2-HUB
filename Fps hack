-- ==========================================================
-- MOTORLAR VE ÇALIŞTIRICI FONKSİYONLAR
-- ==========================================================
local function GetAllTargets()
    local targets = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
            if v ~= LocalPlayer.Character and v.Humanoid.Health > 0 then
                table.insert(targets, v.HumanoidRootPart)
            end
        end
    end
    return targets
end

-- Aimbot Motoru
RunService.RenderStepped:Connect(function()
    if _G.Settings.Aimbot then
        local closest = nil
        local dist = math.huge
        local mouse = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        for _, hrp in pairs(GetAllTargets()) do
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local mag = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
                if mag < dist then
                    dist = mag
                    closest = hrp
                end
            end
        end
        if closest then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closest.Position)
        end
    end
end)

-- ESP Motoru
RunService.RenderStepped:Connect(function()
    if _G.Settings.ESP then
        for _, hrp in pairs(GetAllTargets()) do
            if not hrp.Parent:FindFirstChild("FPS_ESP_BOX") then
                local hl = Instance.new("Highlight", hrp.Parent)
                hl.Name = "FPS_ESP_BOX"
                hl.FillColor = Color3.fromRGB(255, 0, 0)
            end
        end
    end
end)

-- Noclip Motoru
RunService.Stepped:Connect(function()
    if _G.Settings.Noclip and LocalPlayer.Character then
        local char = LocalPlayer.Character
        for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
    end
end)

-- Rapid Fire Motoru
RunService.Heartbeat:Connect(function()
    if _G.Settings.RapidFire and LocalPlayer.Character then
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then
            pcall(function() tool:Activate() end)
        end
    end
end)

-- Inf Jump Motoru
UserInputService.JumpRequest:Connect(function()
    if _G.Settings.InfJump and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- Hitbox Expand Motoru
RunService.Heartbeat:Connect(function()
    if _G.Settings.HitboxExpand then
        for _, hrp in pairs(GetAllTargets()) do
            hrp.Size = Vector3.new(5, 5, 5)
            hrp.Transparency = 0.5
            hrp.CanCollide = false
        end
    end
end)

