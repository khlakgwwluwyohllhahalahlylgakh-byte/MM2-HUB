-- ==================== YARDIMCI FONKSİYONLAR ====================
local function GetPlayers()
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            if Settings.Aimbot.TeamCheck and player.Team == LocalPlayer.Team then continue end
            table.insert(list, player)
        end
    end
    return list
end

local function GetClosestPlayer()
    local players = GetPlayers()
    if #players == 0 then return nil end
    local closest, closestDist = nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()
    for _, player in ipairs(players) do
        local head = player.Character:FindFirstChild("Head")
        if not head then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen and Settings.Aimbot.TargetMode ~= "Kamera İçi" then continue end
        local dist
        if Settings.Aimbot.TargetMode == "Kamera İçi" then
            dist = (Camera.CFrame.Position - head.Position).Magnitude
        else
            dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mousePos.X, mousePos.Y)).Magnitude
        end
        if dist < closestDist then
            closestDist = dist
            closest = player
        end
    end
    return closest
end

local function GetTarget()
    local players = GetPlayers()
    if #players == 0 then return nil end
    if Settings.Aimbot.TargetMode == "Rastgele" then
        return players[math.random(1, #players)]
    elseif Settings.Aimbot.TargetMode == "En Düşük Sağlık" then
        local lowest = nil
        local lowestHealth = math.huge
        for _, player in ipairs(players) do
            local health = player.Character.Humanoid.Health
            if health < lowestHealth then
                lowestHealth = health
                lowest = player
            end
        end
        return lowest
    else
        return GetClosestPlayer()
    end
end

local function IsVisible(part)
    if not part then return false end
    local ray = Ray.new(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * 1000)
    local hit, _ = workspace:FindPartOnRay(ray, LocalPlayer.Character)
    if hit then
        local parent = hit.Parent
        if parent and (parent:IsA("Model") and parent:FindFirstChild("Humanoid")) then
            return true
        end
        return false
    end
    return true
end

-- ==================== AİMBOT & FOV ====================
local function DrawFOVCircle()
    if Settings.Aimbot.ShowFOVCircle then
        if not FOVCircle then
            FOVCircle = Drawing.new("Circle")
            FOVCircle.Thickness = 2
            FOVCircle.Visible = true
        end
        FOVCircle.Radius = Settings.Aimbot.FOV * 2
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        FOVCircle.Color = Settings.Aimbot.FOVCircleColor
        FOVCircle.Filled = false
        FOVCircle.Visible = true
    else
        if FOVCircle then
            FOVCircle.Visible = false
        end
    end
end

local function Aimbot()
    if not Settings.Aimbot.Enabled then return end
    local target = GetTarget()
    if not target then return end
    local aimPart = target.Character:FindFirstChild(Settings.Aimbot.AimPart) or target.Character:FindFirstChild("Head")
    if not aimPart then return end

    if Settings.Aimbot.VisibleCheck and not IsVisible(aimPart) then return end

    local targetPos = aimPart.Position
    if Settings.Aimbot.Prediction then
        local velocity = target.Character.HumanoidRootPart.Velocity
        targetPos = targetPos + velocity * Settings.Aimbot.PredictionAmount
    end

    if Settings.Aimbot.Silent then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
    else
        local currentCF = Camera.CFrame
        local targetCF = CFrame.new(currentCF.Position, targetPos)
        if Settings.Aimbot.LockOn then
            Camera.CFrame = targetCF
        else
            local smooth = Settings.Aimbot.Smoothness
            Camera.CFrame = currentCF:Lerp(targetCF, smooth)
        end
    end
end

-- ==================== TRIGGERBOT ====================
local TriggerbotCooldown = 0
local function Triggerbot()
    if not Settings.Triggerbot.Enabled then return end
    if tick() - TriggerbotCooldown < Settings.Triggerbot.Delay then return end
    local mouse = UserInputService:GetMouseLocation()
    local target = GetClosestPlayer()
    if not target then return end
    local aimPart = target.Character:FindFirstChild("Head")
    if not aimPart then return end
    local screenPos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
    if not onScreen then return end
    local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
    if dist > Settings.Aimbot.FOV then return end
    if Settings.Triggerbot.OnlyVisible and not IsVisible(aimPart) then return end

    mouse1click()
    TriggerbotCooldown = tick()
end

-- ==================== ESP SİSTEMİ ====================
local function CreateESP(player)
    if not Settings.ESP.Enabled then return end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
    if ESPObjects[player] then return end

    local esp = {}

    if Settings.ESP.Box then
        local box = Drawing.new("Square")
        box.Thickness = 2
        box.Color = Settings.ESP.Color
        box.Visible = true
        esp.Box = box
    end

    if Settings.ESP.Name then
        local name = Drawing.new("Text")
        name.Color = Color3.new(1,1,1)
        name.Size = 14
        name.Center = true
        name.Visible = true
        esp.Name = name
    end

    if Settings.ESP.Health then
        local healthBar = Drawing.new("Line")
        healthBar.Thickness = 3
        healthBar.Color = Color3.new(0,1,0)
        healthBar.Visible = true
        esp.Health = healthBar
    end

    if Settings.ESP.Distance then
        local dist = Drawing.new("Text")
        dist.Color = Color3.new(1,1,1)
        dist.Size = 12
        dist.Center = true
        dist.Visible = true
        esp.Distance = dist
    end

    if Settings.ESP.Tracer then
        local tracer = Drawing.new("Line")
        tracer.Thickness = 1
        tracer.Color = Settings.ESP.Color
        tracer.Visible = true
        esp.Tracer = tracer
    end

    if Settings.ESP.Highlight then
        local highlight = Instance.new("Highlight")
        highlight.Parent = player.Character
        highlight.FillColor = Settings.ESP.Color
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color3.new(1,1,1)
        highlight.OutlineTransparency = 0
        esp.Highlight = highlight
    end

    ESPObjects[player] = esp
end

local function UpdateESP()
    for player, esp in pairs(ESPObjects) do
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            for _, obj in pairs(esp) do
                if obj and obj.Visible ~= nil then obj.Visible = false end
                if obj and obj.Parent then obj.Parent = nil end
            end
            continue
        end
        local hrp = player.Character.HumanoidRootPart
        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            for _, obj in pairs(esp) do
                if obj and obj.Visible ~= nil then obj.Visible = false end
            end
            continue
        end

        local size = hrp.Size.Y * 2
        local top = screenPos.Y - size/2
        local bottom = screenPos.Y + size/2
        local left = screenPos.X - size/2

        if Settings.ESP.Box and esp.Box then
            esp.Box.Position = Vector2.new(left, top)
            esp.Box.Size = Vector2.new(size, size)
            esp.Box.Color = Settings.ESP.Color
            esp.Box.Visible = true
        end

        if Settings.ESP.Name and esp.Name then
            esp.Name.Position = Vector2.new(screenPos.X, top - 20)
            esp.Name.Text = player.Name
            esp.Name.Visible = true
        end

        if Settings.ESP.Health and esp.Health then
            local health = player.Character.Humanoid.Health / player.Character.Humanoid.MaxHealth
            local barWidth = size * 0.8
            local barX = left + (size - barWidth)/2
            local yPos = bottom + 5
            esp.Health.From = Vector2.new(barX, yPos)
            esp.Health.To = Vector2.new(barX + barWidth * health, yPos)
            esp.Health.Color = Color3.new(1 - health, health, 0)
            esp.Health.Visible = true
        end

        if Settings.ESP.Distance and esp.Distance then
            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            esp.Distance.Position = Vector2.new(screenPos.X, bottom + 20)
            esp.Distance.Text = string.format("%.1fm", dist/3.28)
            esp.Distance.Visible = true
        end

        if Settings.ESP.Tracer and esp.Tracer then
            if Settings.ESP.TracerOrigin == "Bottom" then
                esp.Tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            else
                esp.Tracer.From = Vector2.new(Camera.ViewportSize.X/2, 0)
            end
            esp.Tracer.To = Vector2.new(screenPos.X, screenPos.Y)
            esp.Tracer.Color = Settings.ESP.Color
            esp.Tracer.Visible = true
        end
    end
end

-- ==================== HAREKET & FLY ====================
local FlyData = {enabled = false, speed = 50}
local function ToggleFly(enable)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.PlatformStand = enable
    end
    FlyData.enabled = enable
    FlyData.speed = Settings.Movement.FlySpeed
end

local function FlyUpdate()
    if not FlyData.enabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local moveDirection = Vector3.new(0,0,0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + hrp.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - hrp.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - hrp.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + hrp.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDirection = moveDirection - Vector3.new(0,1,0) end
    if moveDirection.Magnitude > 0 then
        moveDirection = moveDirection.Unit * FlyData.speed
    end
    hrp.Velocity = moveDirection
end

local function ApplyMovement()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.WalkSpeed = Settings.Movement.WalkSpeed
        hum.JumpPower = Settings.Movement.JumpPower
        if Settings.Movement.AutoJump then
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            if hum.Sit then hum.Sit = false end
            hum.Jump = true
        end
        if Settings.Movement.SuperJump then
            hum.JumpPower = Settings.Movement.JumpPower * Settings.Movement.JumpMultiplier
        end
    end
    if Settings.Movement.NoClip then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
    if Settings.Movement.Fly and not FlyData.enabled then
        ToggleFly(true)
    elseif not Settings.Movement.Fly and FlyData.enabled then
        ToggleFly(false)
    end
    if Settings.Misc.NoFallDamage and hum then
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    end
end

-- ==================== SİLAH MODLARI ====================
local function ApplyWeaponMods()
    local char = LocalPlayer.Character
    if not char then return end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            if Settings.Weapons.NoRecoil then
                if tool:FindFirstChild("Recoil") then tool.Recoil.Value = 0 end
                if tool:FindFirstChild("Kickback") then tool.Kickback.Value = 0 end
            end
            if Settings.Weapons.NoSpread then
                if tool:FindFirstChild("Spread") then tool.Spread.Value = 0 end
            end
            if Settings.Weapons.InfiniteAmmo then
                if tool:FindFirstChild("Ammo") then tool.Ammo.Value = math.huge end
                if tool:FindFirstChild("MaxAmmo") then tool.MaxAmmo.Value = math.huge end
            end
            if Settings.Weapons.InstantReload then
                if tool:FindFirstChild("ReloadTime") then tool.ReloadTime.Value = 0 end
            end
            if Settings.Weapons.RapidFire then
                if tool:FindFirstChild("FireRate") then tool.FireRate.Value = Settings.Weapons.RapidFireDelay end
            end
        end
    end
end

-- ==================== MISC ====================
local function AntiAFK()
    if Settings.Misc.AntiAFK then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end

local function ExpandHitbox()
    if not Settings.Misc.HitboxExpander then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            for _, part in ipairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name == "HumanoidRootPart" then
                    part.Size = Vector3.new(Settings.Misc.HitboxSize, Settings.Misc.HitboxSize, Settings.Misc.HitboxSize)
                end
            end
        end
    end
end

-- ==================== ANA DÖNGÜ ====================
RunService.RenderStepped:Connect(function()
    pcall(function()
        if Settings.Aimbot.Enabled then Aimbot() end
        if Settings.Triggerbot.Enabled then
            if Settings.Triggerbot.AutoFire then
                if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                    Triggerbot()
                end
            else
                Triggerbot()
            end
        end

        if Settings.ESP.Enabled then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    if not ESPObjects[player] then
                        CreateESP(player)
                    end
                end
            end
            UpdateESP()
            DrawFOVCircle()
        else
            ClearESP()
            if FOVCircle then FOVCircle.Visible = false end
        end

        ApplyMovement()
        FlyUpdate()
        ApplyWeaponMods()
        AntiAFK()
        ExpandHitbox()

        if Settings.Weapons.FullAuto then
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                mouse1click()
            end
        end
    end)
end)

