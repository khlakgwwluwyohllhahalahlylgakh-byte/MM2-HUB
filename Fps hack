-- Auto Collect (örnek)
local function AutoCollect()
    if not Settings.Misc.AutoCollect then return end
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and v:FindFirstChild("Collect") then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local dist = (v.Position - char.HumanoidRootPart.Position).Magnitude
                if dist < 20 then
                    -- topla
                    v.CFrame = char.HumanoidRootPart.CFrame + Vector3.new(0, 2, 0)
                end
            end
        end
    end
end

-- Hitbox Expander
local function ExpandHitbox()
    if not Settings.Misc.HitboxExpander then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            for _, part in ipairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Size = Vector3.new(Settings.Misc.HitboxSize, Settings.Misc.HitboxSize, Settings.Misc.HitboxSize)
                end
            end
        end
    end
end

-- ==================== ANA DÖNGÜ ====================
RunService.RenderStepped:Connect(function()
    pcall(function()
        -- Aimbot & Triggerbot
        if Settings.Aimbot.Enabled then Aimbot() end
        if Settings.Triggerbot.Enabled and Settings.Triggerbot.AutoFire then
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                Triggerbot()
            end
        elseif Settings.Triggerbot.Enabled then
            Triggerbot()
        end

        -- ESP
        if Settings.ESP.Enabled then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    if not ESPObjects[player] then
                        CreateESP(player)
                    end
                end
            end
            UpdateESP()
            DrawFOVCircle()
        else
            ClearESP()
            if FOVCircle then FOVCircle.Visible = false end
        end

        -- Hareket
        ApplyMovement()
        FlyUpdate()

        -- Silah
        ApplyWeaponMods()
        Wallbang()

        -- Misc
        AntiAFK()
        AutoCollect()
        ExpandHitbox()

        -- Hızlı ateş (FullAuto) için MouseDown olayını yakala
        if Settings.Weapons.FullAuto then
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                -- Otomatik ateş: her frame'de ateş et
                mouse1click()
            end
        end
    end)
end)

