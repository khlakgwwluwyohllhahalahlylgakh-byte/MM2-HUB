-- ÇALIŞTIRICI MOTORLAR (ENGINE LOOPS)
-- ==========================================================
local function GetAllTargets()
    local targets = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
            if v ~= LocalPlayer.Character and v.Humanoid.Health > 0 then
                table.insert(targets, v.HumanoidRootPart)
            end
        end
    end
    return targets
end

-- FOV Çizim Objesi (Drawing API)
local FOVCircle = nil
if Drawing then
    FOVCircle = Drawing.new("Circle")
    FOVCircle.Thickness = 1.5
    FOVCircle.Color = Color3.fromRGB(0, 255, 140)
    FOVCircle.Filled = false
    FOVCircle.Transparency = 1
end

-- Aimbot & FOV Loop
RunService.RenderStepped:Connect(function()
    local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    if FOVCircle then
        FOVCircle.Visible = _G.Settings.FOVShow
        FOVCircle.Radius = _G.Settings.FOVRadius
        FOVCircle.Position = mousePos
    end

    if _G.Settings.Aimbot then
        local closest = nil
        local dist = _G.Settings.FOVShow and _G.Settings.FOVRadius or math.huge
        
        for _, hrp in pairs(GetAllTargets()) do
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local mag = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                if mag < dist then
                    dist = mag
                    closest = hrp
                end
            end
        end
        if closest then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closest.Position)
        end
    end

    if _G.Settings.Fullbright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
    end
end)

-- ESP Loop
RunService.RenderStepped:Connect(function()
    if _G.Settings.ESP then
        for _, hrp in pairs(GetAllTargets()) do
            if not hrp.Parent:FindFirstChild("FPS_ESP_BOX") then
                local hl = Instance.new("Highlight", hrp.Parent)
                hl.Name = "FPS_ESP_BOX"
                hl.FillColor = Color3.fromRGB(255, 30, 30)
            end
        end
    end
end)

-- Noclip Loop
RunService.Stepped:Connect(function()
    if _G.Settings.Noclip and LocalPlayer.Character then
        for _, p in pairs(LocalPlayer.Character:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
    end
end)

-- RapidFire & Triggerbot & Hitbox Loop
RunService.Heartbeat:Connect(function()
    if LocalPlayer.Character then
        -- Character Speed Fix
        local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
        if humanoid then
            if _G.Settings.WalkSpeed ~= 16 then humanoid.WalkSpeed = _G.Settings.WalkSpeed end
            if _G.Settings.JumpPower ~= 50 then humanoid.JumpPower = _G.Settings.JumpPower end
        end

        -- Rapid Fire
        if _G.Settings.RapidFire then
            local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
            if tool then
                pcall(function() tool:Activate() end)
            end
        end

        -- Triggerbot
        if _G.Settings.Triggerbot then
            local ray = Camera:ViewportPointToRay(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
            local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000)
            if result and result.Instance then
                local model = result.Instance:FindFirstAncestorOfClass("Model")
                if model and model:FindFirstChild("Humanoid") and model ~= LocalPlayer.Character then
                    local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if tool then pcall(function() tool:Activate() end) end
                end
            end
        end
    end

    -- Hitbox Expand
    if _G.Settings.HitboxExpand then
        for _, hrp in pairs(GetAllTargets()) do
            hrp.Size = Vector3.new(_G.Settings.HitboxSize, _G.Settings.HitboxSize, _G.Settings.HitboxSize)
            hrp.Transparency = 0.5
            hrp.CanCollide = false
        end
    end
end)

-- Infinite Jump Listener
UserInputService.JumpRequest:Connect(function()
