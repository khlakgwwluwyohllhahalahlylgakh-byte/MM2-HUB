-- 2. ÖZELLİKLER VE AYARLAR
-- ==========================================================
_G.Settings = { Aimbot = false, ESP = false, Noclip = false, RapidFire = false, InfJump = false, HitboxExpand = false }

local function AddToggle(name, setting)
    local btn = Instance.new("TextButton", Container)
    btn.Size = UDim2.new(0.9, 0, 0, 45)
    btn.Position = UDim2.new(0.05, 0, 0, #Container:GetChildren() * 50)
    btn.Text = name .. " [OFF]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50) -- MM2 Buton Rengi
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        _G.Settings[setting] = not _G.Settings[setting]
        btn.Text = name .. (_G.Settings[setting] and " [ON]" or " [OFF]")
        btn.BackgroundColor3 = _G.Settings[setting] and Color3.fromRGB(0, 180, 0) or Color3.fromRGB(50, 50, 50)
    end)
end

AddToggle("Aimbot (Botlar Dahil)", "Aimbot")
AddToggle("ESP (Botlar Dahil)", "ESP")
AddToggle("Noclip", "Noclip")
AddToggle("Rapid Fire", "RapidFire")
AddToggle("Inf Jump (Fix)", "InfJump")
AddToggle("Hitbox Expand", "HitboxExpand")

-- ==========================================================
-- 3. MOTORLAR
-- ==========================================================
local function GetAllTargets()
    local targets = {}
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
            if v ~= LocalPlayer.Character and v.Humanoid.Health > 0 then
                table.insert(targets, v.HumanoidRootPart)
            end
        end
    end
    return targets
end

-- Aimbot Motoru
RunService.RenderStepped:Connect(function()
    if _G.Settings.Aimbot then
        local closest = nil
        local dist = math.huge
        local mouse = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        for _, hrp in pairs(GetAllTargets()) do
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local mag = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
                if mag < dist then dist = mag; closest = hrp end
            end
        end
        if closest then Camera.CFrame = CFrame.new(Camera.CFrame.Position, closest.Position) end
    end
end)

-- ESP Motoru
RunService.RenderStepped:Connect(function()
    if _G.Settings.ESP then
        for _, hrp in pairs(GetAllTargets()) do
            if not hrp.Parent:FindFirstChild("FPS_ESP_BOX") then
                local hl = Instance.new("Highlight", hrp.Parent)
                hl.Name = "FPS_ESP_BOX"
                hl.FillColor = Color3.fromRGB(255, 0, 0)
            end
        end
    else
        for _, v in pairs(Workspace:GetDescendants()) do if v.Name == "FPS_ESP_BOX" then v:Destroy() end end
    end
end)

-- Diğer Modüller
RunService.Stepped:Connect(function()
    if _G.Settings.Noclip and LocalPlayer.Character then
        for _, p in pairs(LocalPlayer.Character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
    end
end)

RunService.Heartbeat:Connect(function()
    if _G.Settings.RapidFire and LocalPlayer.Character then
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
    end
end)

UserInputService.JumpRequest:Connect(function()
    if _G.Settings.InfJump and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

RunService.Heartbeat:Connect(function()
    if _G.Settings.HitboxExpand then
        for _, hrp in pairs(GetAllTargets()) do
            hrp.Size = Vector3.new(5, 5, 5)
            hrp.Transparency = 0.5
            hrp.CanCollide = false
        end
    end
end)

print("MM2 Stili FPS Hub v5.0 Yüklendi!")
