-- ==================== YARDIMCI FONKSİYONLAR ====================
local function GetPlayers()
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            if Settings.Aimbot.TeamCheck and player.Team == LocalPlayer.Team then continue end
            table.insert(list, player)
        end
    end
    return list
end

local function GetClosestPlayer()
    local players = GetPlayers()
    if #players == 0 then return nil end
    local closest, closestDist = nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()
    for _, player in ipairs(players) do
        local head = player.Character:FindFirstChild("Head")
        if not head then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen and Settings.Aimbot.TargetMode ~= "Kamera İçi" then continue end
        local dist
        if Settings.Aimbot.TargetMode == "Kamera İçi" then
            dist = (Camera.CFrame.Position - head.Position).Magnitude
        else
            dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mousePos.X, mousePos.Y)).Magnitude
        end
        if dist < closestDist then
            closestDist = dist
            closest = player
        end
    end
    return closest
end

local function GetTarget()
    local players = GetPlayers()
    if #players == 0 then return nil end
    if Settings.Aimbot.TargetMode == "Rastgele" then
        return players[math.random(1, #players)]
    elseif Settings.Aimbot.TargetMode == "En Düşük Sağlık" then
        local lowest = nil
        local lowestHealth = math.huge
        for _, player in ipairs(players) do
            local health = player.Character.Humanoid.Health
            if health < lowestHealth then
                lowestHealth = health
                lowest = player
            end
        end
        return lowest
    else
        return GetClosestPlayer()
    end
end

local function IsVisible(part)
    if not part then return false end
    local ray = Ray.new(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * 1000)
    local hit, pos = workspace:FindPartOnRay(ray, LocalPlayer.Character)
    if hit then
        local parent = hit.Parent
        if parent and (parent:IsA("Model") and parent:FindFirstChild("Humanoid")) then
            return true
        end
        return false
    end
    return true
end

-- ==================== AİMBOT ====================
local FOVCircle
local function DrawFOVCircle()
    if Settings.Aimbot.ShowFOVCircle then
        if not FOVCircle then
            FOVCircle = Drawing.new("Circle")
            FOVCircle.Thickness = 2
            FOVCircle.Visible = true
        end
        FOVCircle.Radius = Settings.Aimbot.FOV * 2
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        FOVCircle.Color = Settings.Aimbot.FOVCircleColor
        FOVCircle.Filled = false
        FOVCircle.Visible = true
    else
        if FOVCircle then
            FOVCircle.Visible = false
        end
    end
end

local function Aimbot()
    if not Settings.Aimbot.Enabled then return end
    local target = GetTarget()
    if not target then return end
    local aimPart = target.Character:FindFirstChild(Settings.Aimbot.AimPart) or target.Character:FindFirstChild("Head")
    if not aimPart then return end

    if Settings.Aimbot.VisibleCheck and not IsVisible(aimPart) then return end

    local targetPos = aimPart.Position
    if Settings.Aimbot.Prediction then
        local velocity = target.Character.HumanoidRootPart.Velocity
        targetPos = targetPos + velocity * Settings.Aimbot.PredictionAmount
    end

    if Settings.Aimbot.Silent then
        -- Silent Aim: Mouse'u hareket ettirmeden kamerayı hedefe döndür
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
    else
        local currentCF = Camera.CFrame
        local targetCF = CFrame.new(currentCF.Position, targetPos)
        if Settings.Aimbot.LockOn then
            Camera.CFrame = targetCF
        else
            local smooth = Settings.Aimbot.Smoothness
            Camera.CFrame = currentCF:Lerp(targetCF, smooth)
        end
    end
end

-- ==================== TRIGGERBOT ====================
local TriggerbotCooldown = 0
local function Triggerbot()
    if not Settings.Triggerbot.Enabled then return end
    if tick() - TriggerbotCooldown < Settings.Triggerbot.Delay then return end
    local mouse = UserInputService:GetMouseLocation()
    local target = GetClosestPlayer()
    if not target then return end
    local aimPart = target.Character:FindFirstChild("Head")
    if not aimPart then return end
    local screenPos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
    if not onScreen then return end
    local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
    if dist > Settings.Aimbot.FOV then return end
    if Settings.Triggerbot.OnlyVisible and not IsVisible(aimPart) then return end

    mouse1click()
    TriggerbotCooldown = tick()
end

