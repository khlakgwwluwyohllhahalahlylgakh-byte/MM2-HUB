local ESPObjects = {}
local function CreateESP(player)
    if not Settings.ESP.Enabled then return end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
    if ESPObjects[player] then return end

    local esp = {}
    local hrp = player.Character.HumanoidRootPart

    if Settings.ESP.Box then
        local box = Drawing.new("Square")
        box.Thickness = 2
        box.Color = Settings.ESP.Color
        box.Visible = true
        esp.Box = box
    end

    if Settings.ESP.Box3D then
        -- 3D kutu çizimi (basit çizgilerle)
        local lines = {}
        for i = 1, 12 do
            local line = Drawing.new("Line")
            line.Thickness = 1
            line.Color = Settings.ESP.Color
            line.Visible = true
            table.insert(lines, line)
        end
        esp.Box3D = lines
    end

    if Settings.ESP.Name then
        local name = Drawing.new("Text")
        name.Color = Color3.new(1,1,1)
        name.Size = 14
        name.Center = true
        name.Visible = true
        esp.Name = name
    end

    if Settings.ESP.Health then
        local healthBar = Drawing.new("Line")
        healthBar.Thickness = 3
        healthBar.Color = Color3.new(0,1,0)
        healthBar.Visible = true
        esp.Health = healthBar
    end

    if Settings.ESP.Distance then
        local dist = Drawing.new("Text")
        dist.Color = Color3.new(1,1,1)
        dist.Size = 12
        dist.Center = true
        dist.Visible = true
        esp.Distance = dist
    end

    if Settings.ESP.Tracer then
        local tracer = Drawing.new("Line")
        tracer.Thickness = 1
        tracer.Color = Settings.ESP.Color
        tracer.Visible = true
        esp.Tracer = tracer
    end

    if Settings.ESP.Highlight then
        local highlight = Instance.new("Highlight")
        highlight.Parent = player.Character
        highlight.FillColor = Settings.ESP.Color
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color3.new(1,1,1)
        highlight.OutlineTransparency = 0
        esp.Highlight = highlight
    end

    if Settings.ESP.Chams then
        for _, part in ipairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                local original = part.Transparency
                part.Transparency = 0.3
                part.Color = Settings.ESP.Color
                part.Material = Enum.Material.Neon
                table.insert(esp, {part = part, original = original})
            end
        end
    end

    ESPObjects[player] = esp
end

local function UpdateESP()
    for player, esp in pairs(ESPObjects) do
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            for _, obj in pairs(esp) do
                if obj and obj.Visible ~= nil then obj.Visible = false end
                if obj and obj.Parent then obj.Parent = nil end
            end
            continue
        end
        local hrp = player.Character.HumanoidRootPart
        local head = player.Character:FindFirstChild("Head") or hrp
        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            for _, obj in pairs(esp) do
                if obj and obj.Visible ~= nil then obj.Visible = false end
            end
            continue
        end

        local size = hrp.Size.Y * 2
        local top = screenPos.Y - size/2
        local bottom = screenPos.Y + size/2
        local left = screenPos.X - size/2
        local right = screenPos.X + size/2

        if Settings.ESP.Box and esp.Box then
            esp.Box.Position = Vector2.new(left, top)
            esp.Box.Size = Vector2.new(size, size)
            esp.Box.Visible = true
        end

        if Settings.ESP.Box3D and esp.Box3D then
            -- Basit 3D kutu (köşeleri birleştir)
            local corners = {
                Vector3.new(-1,-1,-1), Vector3.new(1,-1,-1),
                Vector3.new(1,-1,1), Vector3.new(-1,-1,1),
                Vector3.new(-1,1,-1), Vector3.new(1,1,-1),
                Vector3.new(1,1,1), Vector3.new(-1,1,1)
            }
            local size3 = hrp.Size / 2
            local pos = hrp.Position
            local worldCorners = {}
            for _, c in ipairs(corners) do
                local p = pos + Vector3.new(c.X * size3.X, c.Y * size3.Y, c.Z * size3.Z)
                local sp, _ = Camera:WorldToViewportPoint(p)
                table.insert(worldCorners, Vector2.new(sp.X, sp.Y))
            end
            local edges = {
                {1,2},{2,3},{3,4},{4,1},
                {5,6},{6,7},{7,8},{8,5},
                {1,5},{2,6},{3,7},{4,8}
            }
            for i, edge in ipairs(edges) do
                local line = esp.Box3D[i]
                if line then
                    line.From = worldCorners[edge[1]]
                    line.To = worldCorners[edge[2]]
                    line.Visible = true
                end
            end
        end

        if Settings.ESP.Name and esp.Name then
            esp.Name.Position = Vector2.new(screenPos.X, top - 20)
            esp.Name.Text = player.Name
            esp.Name.Visible = true
        end

        if Settings.ESP.Health and esp.Health then
            local health = player.Character.Humanoid.Health / player.Character.Humanoid.MaxHealth
            local barWidth = size * 0.8
            local barX = left + (size - barWidth)/2
            local yPos = bottom + 5
            esp.Health.From = Vector2.new(barX, yPos)
            esp.Health.To = Vector2.new(barX + barWidth * health, yPos)
            esp.Health.Color = Color3.new(1 - health, health, 0)
            esp.Health.Visible = true
        end

        if Settings.ESP.Distance and esp.Distance then
            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            esp.Distance.Position = Vector2.new(screenPos.X, bottom + 20)
            esp.Distance.Text = string.format("%.1fm", dist/3.28)
            esp.Distance.Visible = true
        end

        if Settings.ESP.Tracer and esp.Tracer then
            if Settings.ESP.TracerOrigin == "Bottom" then
                esp.Tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            else
                esp.Tracer.From = Vector2.new(Camera.ViewportSize.X/2, 0)
            end
            esp.Tracer.To = Vector2.new(screenPos.X, screenPos.Y)
            esp.Tracer.Visible = true
        end
    end
end

local function ClearESP()
    for player, esp in pairs(ESPObjects) do
        for _, obj in pairs(esp) do
            if obj and obj.Remove then obj:Remove() end
            if obj and obj.Parent then obj:Destroy() end
        end
    end
    ESPObjects = {}
end

-- ==================== HAREKET ====================
local FlyData = {enabled = false, speed = 50, direction = Vector3.new(0,0,0)}
local function ToggleFly(enable)
    if enable then
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.PlatformStand = true
        end
        FlyData.enabled = true
        FlyData.speed = Settings.Movement.FlySpeed
    else
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.PlatformStand = false
        end
        FlyData.enabled = false
    end
end

local function FlyUpdate()
    if not FlyData.enabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local moveDirection = Vector3.new(0,0,0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + hrp.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - hrp.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - hrp.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + hrp.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDirection = moveDirection - Vector3.new(0,1,0) end
    if moveDirection.Magnitude > 0 then
        moveDirection = moveDirection.Unit * FlyData.speed
    end
    hrp.Velocity = moveDirection
end

local function ApplyMovement()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.WalkSpeed = Settings.Movement.WalkSpeed
        hum.JumpPower = Settings.Movement.JumpPower
        if Settings.Movement.AutoJump then
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            if hum.Sit then hum.Sit = false end
            if not hum:GetState() == Enum.HumanoidStateType.Jumping then
                hum.Jump = true
            end
        end
        if Settings.Movement.SuperJump then
            hum.JumpPower = Settings.Movement.JumpPower * Settings.Movement.JumpMultiplier
        end
    end
    if Settings.Movement.NoClip then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    else
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
    if Settings.Movement.Fly then
        ToggleFly(true)
    else
        ToggleFly(false)
    end
    if Settings.Movement.NoFallDamage and hum then
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    end
end

-- ==================== SİLAH MODLARI ====================
local function ApplyWeaponMods()
    local char = LocalPlayer.Character
    if not char then return end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            -- NoRecoil: bazı oyunlarda tool içinde 'Recoil' veya 'Kickback' olabilir
            if Settings.Weapons.NoRecoil then
                if tool:FindFirstChild("Recoil") then tool.Recoil.Value = 0 end
                if tool:FindFirstChild("Kickback") then tool.Kickback.Value = 0 end
                if tool:FindFirstChild("Spread") then tool.Spread.Value = 0 end
            end
            if Settings.Weapons.NoSpread then
                if tool:FindFirstChild("Spread") then tool.Spread.Value = 0 end
            end
            if Settings.Weapons.InfiniteAmmo then
                if tool:FindFirstChild("Ammo") then tool.Ammo.Value = math.huge end
                if tool:FindFirstChild("MaxAmmo") then tool.MaxAmmo.Value = math.huge end
                if tool:FindFirstChild("Magazine") then tool.Magazine.Value = math.huge end
            end
            if Settings.Weapons.InstantReload then
                if tool:FindFirstChild("ReloadTime") then tool.ReloadTime.Value = 0 end
                if tool:FindFirstChild("ReloadDuration") then tool.ReloadDuration.Value = 0 end
            end
            if Settings.Weapons.FullAuto then
                -- Otomatik ateş: Tek atışlık silahları otomatik yap
                if tool:FindFirstChild("FireMode") then
                    tool.FireMode.Value = "Auto"
                elseif tool:FindFirstChild("Auto") then
                    tool.Auto.Value = true
                else
                    -- Bazı oyunlarda, MouseDown olayını simüle etmek gerek
                    -- Burada basit bir yaklaşım: mouse tuşuna basılı tutarken sürekli ateş et
                end
            end
            if Settings.Weapons.RapidFire then
                -- Ateş hızını artır: Cooldown veya FireRate değerini düşür
                if tool:FindFirstChild("FireRate") then
                    tool.FireRate.Value = Settings.Weapons.RapidFireDelay
                elseif tool:FindFirstChild("Cooldown") then
                    tool.Cooldown.Value = Settings.Weapons.RapidFireDelay
                end
            end
            if Settings.Weapons.Wallbang then
                -- Wallbang: Mermilerin duvarlardan geçmesi için, mermi çarpma olayını engelle
                -- Genellikle oyuna özgü, ama deneme amaçlı
            end
        end
    end
end

