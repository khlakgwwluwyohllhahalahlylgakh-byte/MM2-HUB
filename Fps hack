                    local hl = char:FindFirstChild("FPS_ESP")
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "FPS_ESP"
                        hl.FillColor = Color3.fromRGB(255, 40, 40)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.Parent = char
                    end
                end
            end
        end))
    end)

