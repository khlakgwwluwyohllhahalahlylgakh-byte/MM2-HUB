local function StartFly()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = LocalPlayer.Character.HumanoidRootPart
    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    
    flyAttachment = Instance.new("Attachment", hrp)
    flyLV = Instance.new("LinearVelocity", hrp)
    flyLV.Attachment0 = flyAttachment
    flyLV.MaxForce = math.huge
    flyLV.VectorVelocityMode = Enum.VectorVelocityMode.Vector
    
    flyAlign = Instance.new("AlignOrientation", hrp)
    flyAlign.Attachment0 = flyAttachment
    flyAlign.MaxTorque = math.huge
    flyAlign.Responsiveness = 200
    
    flying = true
    if hum then hum.PlatformStand = true end
end

local function StopFly()
    flying = false
    if flyAttachment then flyAttachment:Destroy() end
    if flyLV then flyLV:Destroy() end
    if flyAlign then flyAlign:Destroy() end
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

local function IsVisible(targetPart)
    if not _G.Settings.VisibilityCheck then return true end
    local camPos = Camera.CFrame.Position
    local direction = (targetPart.Position - camPos)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    params.FilterType = Enum.RaycastFilterType.Exclude
    
    local result = Workspace:Raycast(camPos, direction, params)
    if result and result.Instance then
        if result.Instance:FindFirstAncestorOfClass("Model") == targetPart:FindFirstAncestorOfClass("Model") then
            return true
        else
            return false
        end
    end
    return true
end

-- RenderStepped Ana İşlem
RunService.RenderStepped:Connect(function(dt)
    local mousePos = UserInputService:GetMouseLocation()
    local camCF = Camera.CFrame
    
    -- FOV Çemberi
    FOVCircle.Visible = _G.Settings.FOVShow
    FOVCircle.Radius = _G.Settings.FOVRadius
    FOVCircle.Position = mousePos
    FOVCircle.Color = _G.Settings.FOVColor
    
    -- Özel Crosshair Güncelleme
    if _G.Settings.CustomCrosshair then
        local center = Camera.ViewportSize / 2
        local size = 6
        local gap = 3
        
        CrosshairParts.Top.From = Vector2.new(center.X, center.Y - gap - size)
        CrosshairParts.Top.To = Vector2.new(center.X, center.Y - gap)
        CrosshairParts.Top.Visible = true
        
        CrosshairParts.Bottom.From = Vector2.new(center.X, center.Y + gap)
        CrosshairParts.Bottom.To = Vector2.new(center.X, center.Y + gap + size)
        CrosshairParts.Bottom.Visible = true
        
        CrosshairParts.Left.From = Vector2.new(center.X - gap - size, center.Y)
        CrosshairParts.Left.To = Vector2.new(center.X - gap, center.Y)
        CrosshairParts.Left.Visible = true
        
        CrosshairParts.Right.From = Vector2.new(center.X + gap, center.Y)
        CrosshairParts.Right.To = Vector2.new(center.X + gap + size, center.Y)
        CrosshairParts.Right.Visible = true
    else
        for _, line in pairs(CrosshairParts) do line.Visible = false end
    end
    
    -- ESP Motoru
    for plr, draws in pairs(ESP_Objects) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hum = plr.Character:FindFirstChild_Or_FindFirstChildOfClass and plr.Character:FindFirstChildOfClass("Humanoid") or plr.Character:FindFirstChild("Humanoid")
            local hrp = plr.Character.HumanoidRootPart
            
            if hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                
                if onScreen and _G.Settings.ESP then
                    local size = hrp.Size.Y * 0.5
                    local scale = size / (pos.Z * math.tan(math.rad(Camera.FieldOfView / 2)) * 2) * Camera.ViewportSize.Y
                    
                    draws.Box.Visible = _G.Settings.ESP_Box
                    draws.Box.Color = _G.Settings.ESPColor
                    draws.Box.Size = Vector2.new(scale * 1.5, scale * 2)
                    draws.Box.Position = Vector2.new(pos.X - draws.Box.Size.X / 2, pos.Y - draws.Box.Size.Y / 2)
                    
                    draws.Name.Visible = _G.Settings.ESP_Name
                    draws.Name.Text = plr.Name
                    draws.Name.Color = _G.Settings.ESPColor
                    draws.Name.Position = Vector2.new(pos.X, pos.Y - draws.Box.Size.Y / 2 - 15)
                    
                    draws.Distance.Visible = _G.Settings.ESP_Distance
                    draws.Distance.Text = math.floor((hrp.Position - camCF.Position).Magnitude) .. "m"
                    draws.Distance.Color = _G.Settings.ESPColor
                    draws.Distance.Position = Vector2.new(pos.X, pos.Y + draws.Box.Size.Y / 2 + 5)
                    
                    draws.HealthBar.Visible = _G.Settings.ESP_Health
                    draws.HealthBar.Color = Color3.fromRGB(0, 255, 0)
                    draws.HealthBar.Filled = true
                    
                    draws.HealthBarBG.Visible = _G.Settings.ESP_Health
                    draws.HealthBarBG.Color = Color3.fromRGB(0, 0, 0)
                    draws.HealthBarBG.Filled = true
                    draws.HealthBarBG.Size = Vector2.new(2, draws.Box.Size.Y)
                    draws.HealthBarBG.Position = Vector2.new(draws.Box.Position.X - 4, draws.Box.Position.Y)
                    
                    local healthPerc = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    draws.HealthBar.Size = Vector2.new(2, draws.Box.Size.Y * healthPerc)
                    draws.HealthBar.Position = Vector2.new(draws.Box.Position.X - 4, draws.Box.Position.Y + draws.Box.Size.Y * (1 - healthPerc))
                    
                    draws.Tracer.Visible = _G.Settings.Tracers
                    draws.Tracer.Color = _G.Settings.ESPColor
                    draws.Tracer.From = Vector2.new(pos.X, pos.Y)
                    draws.Tracer.To = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                else
                    for _, d in pairs(draws) do d.Visible = false end
                end
            else
                for _, d in pairs(draws) do d.Visible = false end
            end
        else
            for _, d in pairs(draws) do d.Visible = false end
        end
    end

    -- Aimbot Motoru
    local shouldAim = _G.Settings.Aimbot and (not _G.Settings.AimbotHold or isAimbotActive)
    if shouldAim then
        local closest, closestDist = nil, _G.Settings.FOVRadius
        
        for plr, _ in pairs(ESP_Objects) do
            if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                local hrp = plr.Character.HumanoidRootPart
                
                if hum and hum.Health > 0 then
                    if _G.Settings.TeamCheck and plr.Team == LocalPlayer.Team then continue end
                    
                    local targetPart = hrp
                    if _G.Settings.AimPart == "Head" and plr.Character:FindFirstChild("Head") then targetPart = plr.Character.Head end
                    
                    if IsVisible(targetPart) then
                        local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closest = { Part = targetPart, Vel = hrp.Velocity }
                            end
                        end
                    end
                end
            end
        end
        
        if closest then
            local targetPos = closest.Part.Position
            if closest.Vel.Magnitude > 0 then
                targetPos = targetPos + (closest.Vel * _G.Settings.Prediction)
            end
            local targetCF = CFrame.new(camCF.Position, targetPos)
            Camera.CFrame = camCF:Lerp(targetCF, 1 - math.exp(-dt * (10 - _G.Settings.Smoothness * 10)))
        end
    end

    -- Fullbright
    if _G.Settings.Fullbright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
    end

    -- Fly Motoru Hareket Güncelleme
    if flying and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local moveDir = Vector3.new(0,0,0)
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end
        
        if moveDir.Magnitude > 0 then moveDir = moveDir.Unit * _G.Settings.FlySpeed end
        if flyLV then flyLV.VectorVelocity = moveDir end
        if flyAlign then flyAlign.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)) end
    end
end)

