local ESPObjects = {}
local FOVCircle = nil

local function ClearESP()
    for player, esp in pairs(ESPObjects) do
        for _, obj in pairs(esp) do
            if type(obj) == "table" then
                for _, subObj in pairs(obj) do
                    if subObj and subObj.Remove then subObj:Remove() end
                    if subObj and subObj.Parent then subObj:Destroy() end
                end
            else
                if obj and obj.Remove then obj:Remove() end
                if obj and obj.Parent then obj:Destroy() end
            end
        end
    end
    ESPObjects = {}
end

local function FullCleanup()
    Settings.Aimbot.Enabled = false
    Settings.Triggerbot.Enabled = false
    Settings.ESP.Enabled = false
    Settings.Movement.NoClip = false
    Settings.Movement.Fly = false
    Settings.Movement.WalkSpeed = 16
    Settings.Movement.JumpPower = 50

    ClearESP()
    if FOVCircle then
        FOVCircle.Visible = false
        FOVCircle:Remove()
        FOVCircle = nil
    end

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.WalkSpeed = 16
            hum.JumpPower = 50
            hum.PlatformStand = false
        end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

