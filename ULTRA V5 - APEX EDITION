local function refreshLibrary()
    clearCards()
    local query = string.lower(State.Search)
    for _, scriptData in ipairs(State.Scripts) do
        local matches = query == "" or string.find(string.lower(scriptData.Name), query, 1, true) or string.find(string.lower(scriptData.Code), query, 1, true)
        if matches then
            local card = createScriptCard(scriptData, libraryTab)
            table.insert(libraryCards, card)
        end
    end
end

saveButton.MouseButton1Click:Connect(function()
    local name = string.gsub(nameBox.Text, "^%s*(.-)%s*$", "%1")
    local code = codeBox.Text

    if name == "" then notify("Eksik bilgi", "Script adı boş olamaz.", "error") return end
    if code == "" then notify("Eksik bilgi", "Kod alanı boş bırakılamaz.", "error") return end
    if #State.Scripts >= CONFIG.MaxScripts then notify("Limit", "Kütüphane dolu.", "error") return end

    for _, existing in ipairs(State.Scripts) do
        if string.lower(existing.Name) == string.lower(name) then
            notify("Mevcut", "Bu isimde bir script zaten var.", "warning")
            return
        end
    end

    table.insert(State.Scripts, { Name = name, Code = code, Created = os.time() })
    saveScriptsToDisk()

    nameBox.Text = ""
    codeBox.Text = ""
    refreshLibrary()
    notify("Kaydedildi", name .. " kütüphaneye eklendi.", "success")
end)

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    State.Search = searchBox.Text
    refreshLibrary()
end)

