local function addHistory(name)
    table.insert(State.History, 1, { Name = name, Time = os.date("%H:%M:%S") })
    while #State.History > 30 do table.remove(State.History) end
end

local function isFavorite(name)
    return State.Favorites[name] == true
end

local function toggleFavorite(name)
    State.Favorites[name] = not State.Favorites[name]
    saveScriptsToDisk()
    if State.Favorites[name] then
        notify("Favori", name .. " favorilere eklendi.", "success")
    else
        notify("Favori", name .. " favorilerden çıkarıldı.", "warning")
    end
end

