-- ================= GÜVENLİ YÜRÜTME & TEMİZLEME =================
local function sanitizeScript(rawCode)
    local code = rawCode
    code = string.gsub(code, "https?://discord%.com/api/webhooks/%S+", "\"BLOCKED_WEBHOOK\"")
    local flags = {"robloxsecurity", "cookie", "syn.request"}
    for _, flag in ipairs(flags) do code = string.gsub(code, flag, "BLOCKED_KEYWORD") end
    return code
end

local function executeSecurely(rawCode)
    local safeCode = sanitizeScript(rawCode)
    local success, err = pcall(function()
        local func = loadstring(safeCode)
        if not func then func = loadstring("return " .. safeCode) end
        if func then func() else error("Derleme hatası: Kod geçersiz.") end
    end)
    return success, err
end

