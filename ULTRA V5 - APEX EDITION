local UltraV5 = {}
UltraV5.__index = UltraV5

local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local COLORS = {
    Background = Color3.fromRGB(15, 15, 20),
    TopBar = Color3.fromRGB(21, 21, 28),
    Sidebar = Color3.fromRGB(18, 18, 24),
    Element = Color3.fromRGB(25, 25, 34),
    ElementHover = Color3.fromRGB(32, 32, 42),
    Accent = Color3.fromRGB(0, 200, 120),
    AccentDark = Color3.fromRGB(0, 160, 95),
    Text = Color3.fromRGB(240, 240, 245),
    SubText = Color3.fromRGB(165, 165, 175),
    Red = Color3.fromRGB(220, 65, 65)
}

local function Tween(obj, time, props)
    TweenService:Create(
        obj,
        TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        props
    ):Play()
end

local function Corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 6)
    c.Parent = parent
    return c
end

local function Stroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thickness or 1
    s.Transparency = 0.15
    s.Parent = parent
    return s
end

-- ==========================================================
-- CREATE WINDOW
-- ==========================================================

function UltraV5:CreateWindow(options)

    options = options or {}

    local windowName = options.Name or "ULTRA V6"
    local toggleKey = options.ToggleKey or Enum.KeyCode.RightControl

    -- Eski UI
    local old = CoreGui:FindFirstChild("UltraV5_UI")
    if old then
        old:Destroy()
    end

    -- ======================================================
    -- SCREEN GUI
    -- ======================================================

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "UltraV5_UI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = CoreGui

    -- ======================================================
    -- ANA FRAME
    -- ======================================================

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    MainFrame.Position = UDim2.fromScale(0.5, 0.5)

    -- ARTIK DEVASA DEĞİL
    MainFrame.Size = UDim2.new(0, 430, 0, 285)

    MainFrame.BackgroundColor3 = COLORS.Background
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true

    Corner(MainFrame, 10)
    Stroke(MainFrame, COLORS.Accent, 1.2)

    -- Ekran küçükse otomatik küçült
    local UIScale = Instance.new("UIScale")
    UIScale.Parent = MainFrame

    local function UpdateScale()

        local viewport = workspace.CurrentCamera.ViewportSize

        local widthScale = viewport.X / 500
        local heightScale = viewport.Y / 350

        local scale = math.min(widthScale, heightScale)

        scale = math.clamp(scale, 0.65, 1)

        UIScale.Scale = scale
    end

    UpdateScale()

    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateScale)

    -- ======================================================
    -- TOP BAR
    -- ======================================================

    local TopBar = Instance.new("Frame")
    TopBar.Name = "TopBar"
    TopBar.Parent = MainFrame
    TopBar.Size = UDim2.new(1, 0, 0, 34)
    TopBar.BackgroundColor3 = COLORS.TopBar
    TopBar.BorderSizePixel = 0

    -- Başlık
    local Title = Instance.new("TextLabel")
    Title.Parent = TopBar
    Title.BackgroundTransparency = 1
    Title.Position = UDim2.new(0, 12, 0, 0)
    Title.Size = UDim2.new(1, -85, 1, 0)
    Title.Font = Enum.Font.GothamBold
    Title.Text = windowName
    Title.TextColor3 = COLORS.Text
    Title.TextSize = 12
    Title.TextXAlignment = Enum.TextXAlignment.Left

    -- ======================================================
    -- MINIMIZE
    -- ======================================================

    local MinBtn = Instance.new("TextButton")
    MinBtn.Parent = TopBar
    MinBtn.BackgroundColor3 = COLORS.Element
    MinBtn.Position = UDim2.new(1, -62, 0.5, -9)
    MinBtn.Size = UDim2.new(0, 20, 0, 18)
    MinBtn.Font = Enum.Font.GothamBold
    MinBtn.Text = "-"
    MinBtn.TextColor3 = COLORS.SubText
    MinBtn.TextSize = 14
    MinBtn.AutoButtonColor = false

    Corner(MinBtn, 5)

    -- ======================================================
    -- CLOSE
    -- ======================================================

    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Parent = TopBar
    CloseBtn.BackgroundColor3 = COLORS.Red
    CloseBtn.Position = UDim2.new(1, -36, 0.5, -9)
    CloseBtn.Size = UDim2.new(0, 20, 0, 18)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.Text = "×"
    CloseBtn.TextColor3 = Color3.new(1, 1, 1)
    CloseBtn.TextSize = 13
    CloseBtn.AutoButtonColor = false

    Corner(CloseBtn, 5)

    -- ======================================================
    -- CONTENT
    -- ======================================================

    local Content = Instance.new("Frame")
    Content.Name = "Content"
    Content.Parent = MainFrame
    Content.BackgroundTransparency = 1
    Content.Position = UDim2.new(0, 0, 0, 34)
    Content.Size = UDim2.new(1, 0, 1, -34)

    -- ======================================================
    -- SIDEBAR
    -- ======================================================

    local Sidebar = Instance.new("Frame")
    Sidebar.Name = "Sidebar"
    Sidebar.Parent = Content
    Sidebar.BackgroundColor3 = COLORS.Sidebar
    Sidebar.BorderSizePixel = 0
    Sidebar.Size = UDim2.new(0, 120, 1, 0)

    local SidebarPadding = Instance.new("UIPadding")
    SidebarPadding.Parent = Sidebar
    SidebarPadding.PaddingTop = UDim.new(0, 7)
    SidebarPadding.PaddingLeft = UDim.new(0, 7)
    SidebarPadding.PaddingRight = UDim.new(0, 7)

    local SidebarLayout = Instance.new("UIListLayout")
    SidebarLayout.Parent = Sidebar
    SidebarLayout.Padding = UDim.new(0, 4)
    SidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder

    -- ======================================================
    -- CONTAINER
    -- ======================================================

    local Container = Instance.new("Frame")
    Container.Name = "Container"
    Container.Parent = Content
    Container.BackgroundTransparency = 1
    Container.Position = UDim2.new(0, 125, 0, 5)
    Container.Size = UDim2.new(1, -130, 1, -10)

    -- ======================================================
    -- WINDOW OBJECT
    -- ======================================================

    local WindowObj = {
        Tabs = {},
        Destroyed = false
    }

    -- ======================================================
    -- TAB
    -- ======================================================

    function WindowObj:CreateTab(tabName, icon)

        icon = icon or "•"

        local TabPage = Instance.new("ScrollingFrame")
        TabPage.Name = tabName .. "_Page"
        TabPage.Parent = Container
        TabPage.BackgroundTransparency = 1
        TabPage.Size = UDim2.fromScale(1, 1)
        TabPage.BorderSizePixel = 0
        TabPage.ScrollBarThickness = 2
        TabPage.ScrollBarImageColor3 = COLORS.Accent
        TabPage.AutomaticCanvasSize = Enum.AutomaticSize.Y
        TabPage.CanvasSize = UDim2.new()

        TabPage.Visible = false

        local PagePadding = Instance.new("UIPadding")
        PagePadding.Parent = TabPage
        PagePadding.PaddingBottom = UDim.new(0, 5)
        PagePadding.PaddingRight = UDim.new(3, 0)

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.Parent = TabPage
        PageLayout.Padding = UDim.new(0, 5)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder

        -- ==================================================
        -- TAB BUTTON
        -- ==================================================

        local TabBtn = Instance.new("TextButton")
        TabBtn.Name = tabName .. "_Button"
        TabBtn.Parent = Sidebar
        TabBtn.BackgroundColor3 = COLORS.Element
        TabBtn.Size = UDim2.new(1, 0, 0, 28)
        TabBtn.BorderSizePixel = 0
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.Text = "  " .. icon .. "  " .. tabName
        TabBtn.TextColor3 = COLORS.SubText
        TabBtn.TextSize = 10
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        TabBtn.AutoButtonColor = false

        Corner(TabBtn, 5)

        -- Hover
        TabBtn.MouseEnter:Connect(function()

            if not TabPage.Visible then
                Tween(TabBtn, 0.12, {
                    BackgroundColor3 = COLORS.ElementHover
                })
            end

        end)

        TabBtn.MouseLeave:Connect(function()

            if not TabPage.Visible then
                Tween(TabBtn, 0.12, {
                    BackgroundColor3 = COLORS.Element
                })
            end

        end)

        -- ==================================================
        -- ACTIVATE
        -- ==================================================

        local function ActivateTab()

            for _, t in ipairs(WindowObj.Tabs) do

                t.Page.Visible = false

                Tween(t.Button, 0.15, {
                    BackgroundColor3 = COLORS.Element,
                    TextColor3 = COLORS.SubText
                })

            end

            TabPage.Visible = true

            Tween(TabBtn, 0.15, {
                BackgroundColor3 = COLORS.Accent,
                TextColor3 = Color3.new(1, 1, 1)
            })

        end

        TabBtn.MouseButton1Click:Connect(ActivateTab)

        local TabObj = {
            Page = TabPage,
            Button = TabBtn
        }

        table.insert(WindowObj.Tabs, TabObj)

        if #WindowObj.Tabs == 1 then
            ActivateTab()
        end

        -- ==================================================
        -- TOGGLE
        -- ==================================================

        function TabObj:CreateToggle(text, default, callback)

            local state = default == true
            callback = callback or function() end

            local Toggle = Instance.new("TextButton")
            Toggle.Parent = TabPage
            Toggle.BackgroundColor3 = state and COLORS.AccentDark or COLORS.Element
            Toggle.Size = UDim2.new(1, 0, 0, 30)
            Toggle.BorderSizePixel = 0
            Toggle.Font = Enum.Font.Gotham
            Toggle.Text = "  " .. text
            Toggle.TextColor3 = COLORS.Text
            Toggle.TextSize = 10
            Toggle.TextXAlignment = Enum.TextXAlignment.Left
            Toggle.AutoButtonColor = false

            Corner(Toggle, 5)

            local Status = Instance.new("TextLabel")
            Status.Parent = Toggle
            Status.BackgroundTransparency = 1
            Status.AnchorPoint = Vector2.new(1, 0.5)
            Status.Position = UDim2.new(1, -9, 0.5, 0)
            Status.Size = UDim2.new(0, 35, 0, 18)
            Status.Font = Enum.Font.GothamBold
            Status.Text = state and "ON" or "OFF"
            Status.TextColor3 = state and Color3.new(1, 1, 1) or COLORS.SubText
            Status.TextSize = 9

            Toggle.MouseButton1Click:Connect(function()

                state = not state

                Status.Text = state and "ON" or "OFF"

                Tween(Toggle, 0.15, {
                    BackgroundColor3 = state and COLORS.AccentDark or COLORS.Element
                })

                Status.TextColor3 = state and Color3.new(1, 1, 1) or COLORS.SubText

                pcall(callback, state)

            end)

            return {
                Set = function(_, value)

                    state = value == true

                    Status.Text = state and "ON" or "OFF"

                    Toggle.BackgroundColor3 =
                        state and COLORS.AccentDark or COLORS.Element

                    pcall(callback, state)

                end,

                Get = function()
                    return state
                end
            }

        end

        -- ==================================================
        -- BUTTON
        -- ==================================================

        function TabObj:CreateButton(text, callback)

            callback = callback or function() end

            local Button = Instance.new("TextButton")
            Button.Parent = TabPage
            Button.BackgroundColor3 = COLORS.Element
            Button.Size = UDim2.new(1, 0, 0, 30)
            Button.BorderSizePixel = 0
            Button.Font = Enum.Font.GothamMedium
            Button.Text = text
            Button.TextColor3 = COLORS.Text
            Button.TextSize = 10
            Button.AutoButtonColor = false

            Corner(Button, 5)

            Button.MouseEnter:Connect(function()
                Tween(Button, 0.12, {
                    BackgroundColor3 = COLORS.ElementHover
                })
            end)

            Button.MouseLeave:Connect(function()
                Tween(Button, 0.12, {
                    BackgroundColor3 = COLORS.Element
                })
            end)

            Button.MouseButton1Click:Connect(function()
                pcall(callback)
            end)

            return Button

        end

        -- ==================================================
        -- SLIDER
        -- ==================================================

        function TabObj:CreateSlider(text, min, max, default, callback)

            min = min or 0
            max = max or 100
            default = math.clamp(default or min, min, max)

            callback = callback or function() end

            local SliderFrame = Instance.new("Frame")
            SliderFrame.Parent = TabPage
            SliderFrame.BackgroundColor3 = COLORS.Element
            SliderFrame.Size = UDim2.new(1, 0, 0, 42)
            SliderFrame.BorderSizePixel = 0

            Corner(SliderFrame, 5)

            local Label = Instance.new("TextLabel")
            Label.Parent = SliderFrame
            Label.BackgroundTransparency = 1
            Label.Position = UDim2.new(0, 9, 0, 4)
            Label.Size = UDim2.new(1, -18, 0, 15)
            Label.Font = Enum.Font.Gotham
            Label.TextColor3 = COLORS.SubText
            Label.TextSize = 9
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local Track = Instance.new("Frame")
            Track.Parent = SliderFrame
            Track.BackgroundColor3 = COLORS.Background
            Track.Position = UDim2.new(0, 9, 0, 26)
            Track.Size = UDim2.new(1, -18, 0, 7)
            Track.BorderSizePixel = 0

            Corner(Track, 10)

            local Fill = Instance.new("Frame")
            Fill.Parent = Track
            Fill.BackgroundColor3 = COLORS.Accent
            Fill.Size = UDim2.new(0, 0, 1, 0)
            Fill.BorderSizePixel = 0

            Corner(Fill, 10)

            local function SetValue(value)

                value = math.clamp(value, min, max)

                local percent =
                    (value - min) / math.max(max - min, 1)

                Fill.Size = UDim2.new(percent, 0, 1, 0)

                Label.Text =
                    text .. ": " .. tostring(math.floor(value))

                pcall(callback, value)

            end

            SetValue(default)

            local dragging = false

            local function Update(input)

                local percent =
                    math.clamp(
                        (input.Position.X - Track.AbsolutePosition.X)
                        / Track.AbsoluteSize.X,
                        0,
                        1
                    )

                local value =
                    min + ((max - min) * percent)

                SetValue(math.floor(value))

            end

            Track.InputBegan:Connect(function(input)

                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then

                    dragging = true
                    Update(input)

                end

            end)

            UserInputService.InputEnded:Connect(function(input)

                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then

                    dragging = false

                end

            end)

            UserInputService.InputChanged:Connect(function(input)

                if dragging then

                    if input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch then

                        Update(input)

                    end

                end

            end)

            return {
                Set = function(_, value)
                    SetValue(value)
                end
            }

        end

        -- ==================================================
        -- KEYBIND
        -- ==================================================

        function TabObj:CreateKeybind(text, defaultKey, callback)

            local currentKey =
                defaultKey or Enum.KeyCode.RightControl

            callback = callback or function() end

            local Button = Instance.new("TextButton")
            Button.Parent = TabPage
            Button.BackgroundColor3 = COLORS.Element
            Button.Size = UDim2.new(1, 0, 0, 30)
            Button.BorderSizePixel = 0
            Button.Font = Enum.Font.Gotham
            Button.TextColor3 = COLORS.Text
            Button.TextSize = 10
            Button.TextXAlignment = Enum.TextXAlignment.Left
            Button.AutoButtonColor = false

            Corner(Button, 5)

            local function UpdateText()
                Button.Text =
                    "  " .. text .. "   [" .. currentKey.Name .. "]"
            end

            UpdateText()

            local listening = false

            Button.MouseButton1Click:Connect(function()

                listening = true
                Button.Text = "  " .. text .. "   [PRESS KEY]"

            end)

            UserInputService.InputBegan:Connect(function(input)

                if listening
                and input.UserInputType == Enum.UserInputType.Keyboard then

                    currentKey = input.KeyCode
                    listening = false

                    UpdateText()

                    pcall(callback, currentKey)

                end

            end)

            return {
                Get = function()
                    return currentKey
                end,

                Set = function(_, key)
                    currentKey = key
                    UpdateText()
                end
            }

        end

        return TabObj

    end

    -- ======================================================
    -- MINIMIZE
    -- ======================================================

    local minimized = false
    local oldSize = MainFrame.Size

    MinBtn.MouseButton1Click:Connect(function()

        minimized = not minimized

        if minimized then

            Content.Visible = false

            Tween(MainFrame, 0.2, {
                Size = UDim2.new(0, 430, 0, 34)
            })

            MinBtn.Text = "+"

        else

            Tween(MainFrame, 0.2, {
                Size = oldSize
            })

            task.delay(0.18, function()
                if not minimized then
                    Content.Visible = true
                end
            end)

            MinBtn.Text = "-"

        end

    end)

    -- ======================================================
    -- CLOSE
    -- ======================================================

    CloseBtn.MouseButton1Click:Connect(function()

        Tween(MainFrame, 0.15, {
            Size = UDim2.new(0, 390, 0, 0)
        })

        task.delay(0.16, function()

            if ScreenGui then
                ScreenGui:Destroy()
            end

        end)

    end)

    -- ======================================================
    -- TOGGLE KEY
    -- ======================================================

    UserInputService.InputBegan:Connect(function(input, gpe)

        if gpe then
            return
        end

        if input.KeyCode == toggleKey then

            MainFrame.Visible = not MainFrame.Visible

        end

    end)

    -- ======================================================
    -- MOBİL SÜRÜKLEME
    -- ======================================================

    local dragging = false
    local dragStart
    local startPosition

    TopBar.InputBegan:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true

            dragStart = input.Position
            startPosition = MainFrame.Position

        end

    end)

    TopBar.InputEnded:Connect(function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            dragging = false

        end

    end)

    UserInputService.InputChanged:Connect(function(input)

        if not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - dragStart

            MainFrame.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )

        end

    end)

    -- ======================================================
    -- RETURN
    -- ======================================================

    return WindowObj

end

return UltraV5
