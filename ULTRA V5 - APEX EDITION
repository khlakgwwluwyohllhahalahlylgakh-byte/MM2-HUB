local function openWindow()
    if State.Open then return end
    State.Open = true
    main.Visible = true
    if CONFIG.Animation then
        main.Size = UDim2.new(0, 20, 0, 20)
        tween(main, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, CONFIG.WindowWidth, 0, CONFIG.WindowHeight)
        })
    else
        main.Size = UDim2.new(0, CONFIG.WindowWidth, 0, CONFIG.WindowHeight)
    end
    toggleButton.Text = "×"
end

local function closeWindow()
    if not State.Open then return end
    State.Open = false
    if CONFIG.Animation then
        tween(main, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 20, 0, 20)
        })
        task.delay(0.23, function()
            if not State.Open then main.Visible = false end
        end)
    else
        main.Visible = false
    end
    toggleButton.Text = "Δ"
end

toggleButton.MouseButton1Click:Connect(function()
    if State.Open then closeWindow() else openWindow() end
end)
closeButton.MouseButton1Click:Connect(closeWindow)

