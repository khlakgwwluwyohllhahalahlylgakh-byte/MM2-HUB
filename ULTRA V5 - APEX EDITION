    delBtn.Font = Enum.Font.GothamBold
    delBtn.Parent = card
    Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 5)

    playBtn.MouseButton1Click:Connect(function()
        local success, err = executeSecurely(code)
        if success then notify("Çalıştı", name .. " aktif edildi.", false)
        else notify("Hata", tostring(err), true) end
    end)

    delBtn.MouseButton1Click:Connect(function()
        card:Destroy()
        for i, v in ipairs(savedScripts) do
