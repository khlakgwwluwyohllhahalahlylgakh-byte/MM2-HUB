-- Listeyi Oluşturma
for _, cheat in ipairs(cheats) do
    local ItemBtn = Instance.new("TextButton")
    ItemBtn.Parent = ScrollingFrame
    ItemBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    ItemBtn.Size = UDim2.new(1, -4, 0, 48)
    ItemBtn.AutoButtonColor = false
    ItemBtn.Font = Enum.Font.GothamBold
    ItemBtn.Text = "  " .. cheat.Name
    ItemBtn.TextColor3 = cheat.Color
    ItemBtn.TextSize = 14
    ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
    
    local ItemCorner = Instance.new("UICorner")
    ItemCorner.CornerRadius = UDim.new(0, 8)
    ItemCorner.Parent = ItemBtn
    
    local ItemStroke = Instance.new("UIStroke")
    ItemStroke.Parent = ItemBtn
    ItemStroke.Color = Color3.fromRGB(35, 35, 50)
    ItemStroke.Thickness = 1
    
    ItemBtn.MouseEnter:Connect(function()
        TweenService:Create(ItemBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 30, 42)}):Play()
        TweenService:Create(ItemStroke, TweenInfo.new(0.2), {Color = cheat.Color}):Play()
    end)
    
    ItemBtn.MouseLeave:Connect(function()
        TweenService:Create(ItemBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(22, 22, 30)}):Play()
        TweenService:Create(ItemStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(35, 35, 50)}):Play()
    end)
    
    -- Hile Seçildiğinde: Ana menü tamamen yok olur, hile aktif duruma geçer
    ItemBtn.MouseButton1Click:Connect(function()
        pcall(function()
            loadstring(game:HttpGet(cheat.Url))()
        end)
        
        isCheatActive = true
        MainFrame.Visible = false
        ActiveIndicatorText.Text = "Çalışan: " .. cheat.Name
        ActiveWidget.Visible = true
    end)
end

ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, #cheats * 58)

