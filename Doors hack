    local function SwitchPage(name)
        if currentPage == name then return end
        currentPage = name
        
        for _, page in pairs(pages) do 
            page.Visible = false 
        end
        
        if pages[name] then 
            pages[name].Visible = true
            pages[name].CanvasPosition = Vector2.new(0, 0)
        end
        
        -- Tab butonlarını güncelle
        for _, btn in ipairs(TabScrolling:GetChildren()) do
            if btn:IsA("TextButton") and btn:GetAttribute("PageTarget") then
                if btn:GetAttribute("PageTarget") == name then
                    btn.BackgroundColor3 = Color3.fromRGB(120, 0, 255)
                    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    btn.Size = UDim2.new(0, 100, 0, 35) -- 📱 Aktif tab daha geniş
                else
                    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
                    btn.TextColor3 = Color3.fromRGB(180, 180, 190)
                    btn.Size = UDim2.new(0, 85, 0, 35)
                end
            end
        end
    end
    
