local function ReadShapeOrderFromHeart()
    local char = LocalPlayer.Character
    if not char then return {} end
    
    local shapeOrder = {}
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, screen in pairs(playerGui:GetDescendants()) do
            if screen:IsA("ImageLabel") or screen:IsA("Frame") then
                local shapeName = screen.Name
                if shapeName:find("Circle") or shapeName:find("⭕") then
                    table.insert(shapeOrder, "Circle")
                elseif shapeName:find("Square") or shapeName:find("🟩") then
                    table.insert(shapeOrder, "Square")
                elseif shapeName:find("Triangle") or shapeName:find("🔺") then
                    table.insert(shapeOrder, "Triangle")
                elseif shapeName:find("Star") or shapeName:find("⭐") then
                    table.insert(shapeOrder, "Star")
                elseif shapeName:find("Diamond") or shapeName:find("💎") then
                    table.insert(shapeOrder, "Diamond")
                elseif shapeName:find("Cross") or shapeName:find("✖️") then
                    table.insert(shapeOrder, "Cross")
                end
            end
        end
    end
    
    Log("Şekil sırası okundu: " .. table.concat(shapeOrder, " -> "))
    _G.LibrarySystem.ShapeOrder = shapeOrder
    return shapeOrder
end

local function ExtractShapeNumbersFromBooks(room)
    if not room then return {} end
    local bookShapes = {}
    local books = FindBooksInRoom(room)
    
    for _, book in pairs(books) do
        if _G.Settings.AIBot then
            local prompt = book:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                SmartWalk(book.Position, 3)
                task.wait(0.2)
                fireproximityprompt(prompt)
                task.wait(0.5)
                
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if playerGui then
                    for _, textElement in pairs(playerGui:GetDescendants()) do
                        if textElement:IsA("TextLabel") or textElement:IsA("TextBox") then
                            local text = textElement.Text:lower()
                            if text:find("circle") or text:find("⭕") then
                                local number = text:match("%d+")
                                if number then bookShapes["Circle"] = tonumber(number) end
                            elseif text:find("square") or text:find("🟩") then
                                local number = text:match("%d+")
                                if number then bookShapes["Square"] = tonumber(number) end
                            elseif text:find("triangle") or text:find("🔺") then
                                local number = text:match("%d+")
                                if number then bookShapes["Triangle"] = tonumber(number) end
                            elseif text:find("star") or text:find("⭐") then
                                local number = text:match("%d+")
                                if number then bookShapes["Star"] = tonumber(number) end
                            elseif text:find("diamond") or text:find("💎") then
                                local number = text:match("%d+")
                                if number then bookShapes["Diamond"] = tonumber(number) end
                            elseif text:find("cross") or text:find("✖️") then
                                local number = text:match("%d+")
                                if number then bookShapes["Cross"] = tonumber(number) end
                            end
                        end
                    end
                end
                task.wait(0.3)
            end
        end
    end
    
    _G.LibrarySystem.BookShapes = bookShapes
    return bookShapes
end

local function SolvePassword()
    local shapeOrder = _G.LibrarySystem.ShapeOrder
    local bookShapes = _G.LibrarySystem.BookShapes
    
    if #shapeOrder == 0 or not next(bookShapes) then
        Log("Şifre çözme başarısız: Eksik veri")
        LibraryStatusLabel:Set("❌ Şifre çözülemedi")
        return ""
    end
    
    local password = ""
    for _, shape in pairs(shapeOrder) do
        if bookShapes[shape] then
            password = password .. tostring(bookShapes[shape])
        end
    end
    
    Log("✅ Şifre çözüldü: " .. password)
    _G.LibrarySystem.FinalPassword = password
    LibraryStatusLabel:Set("✅ Şifre: " .. password)
    return password
end

