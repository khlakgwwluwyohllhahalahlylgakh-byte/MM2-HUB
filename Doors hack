local function Log(message, level)
    level = level or "INFO"
    if _G.Settings.DebugMode or _G.Settings.VerboseLogging then
        local timestamp = os.date("%H:%M:%S")
        local prefix = string.format("[%s] [%s]", timestamp, level)
        print(prefix .. " " .. message)
    end
end

local function Error(message, critical)
    _G.Statistics.Errors = _G.Statistics.Errors + 1
    Log("[ERROR] " .. message, "ERROR")
    if critical then
        _G.DoorsAI_v12.LastError = message
        Rayfield:Notify({
            Title = "⚠️ Kritik Hata",
            Content = message,
            Duration = 5
        })
    end
end

local function Success(message)
    Log("[SUCCESS] " .. message, "SUCCESS")
end

