-- ==========================================================
-- LOGGING & SAFETY
-- ==========================================================
local function Log(message, level)
    if _G.Settings.DebugMode then print(string.format("[%s] %s", level or "INFO", message)) end
end

local function Error(message)
    _G.Statistics.Errors = _G.Statistics.Errors + 1
    warn("[ERROR] " .. message)
end

local function SafeExecute(func, errorName)
    local success, result = pcall(func)
    if not success then Error("[" .. (errorName or "Unknown") .. "] " .. tostring(result)) end
    return success, result
end

-- ==========================================================
-- FONKSİYONLAR (HEPSİ KORUMALI)
-- ==========================================================
local function GetCurrentRoom()
    local success, gData = pcall(function() return ReplicatedStorage:FindFirstChild("GameData") end)
    if success and gData and gData:FindFirstChild("LatestRoom") then
        local roomNum = gData.LatestRoom.Value
        _G.GameState.CurrentRoomNumber = roomNum
        local rooms = Workspace:FindFirstChild("Rooms")
        return rooms and rooms:FindFirstChild(tostring(roomNum)), roomNum
    end
    return nil, 0
end

local function Distance(pos1, pos2) return (pos1 - pos2).Magnitude end

local function SmoothMoveTo(targetPos, timeout, stoppingDistance)
    stoppingDistance = stoppingDistance or 2.5
    if not Character or not HumanoidRootPart then return false end
    local currentPos = HumanoidRootPart.Position
    local direction = (targetPos - currentPos).Unit
    HumanoidRootPart.CFrame = CFrame.new(currentPos + (direction * _G.Settings.SmoothSpeed * 0.1), targetPos + Vector3.new(0, 1, 0))
    return true
end

-- Library Puzzle & Entity logic (Tüm orijinal kod korunmuştur)
local function SolveLibrary(room)
    if not _G.Settings.AutoSolveLibrary then return end
    SafeExecute(function()
        for _, obj in pairs(room:GetDescendants()) do
            if obj.Name:find("Book") or obj.Name:find("Hint") then
                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then fireproximityprompt(prompt) end
            end
        end
    end, "SolveLibrary")
end

