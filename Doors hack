-- AKICI HAREKET VE GÜVENLİ UÇMA MOTORU (SAFE PATH-FLY ENGINE)
-- ==========================================================

local function SmartWalk(targetPos, maxWait)
    maxWait = maxWait or 5
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if not hum or not hrp then return false end
    
    _G.CancelWalk = false
    local startTime = tick()
    hum.WalkSpeed = _G.Settings.SafeWalkSpeed

    -- Uçma veya Yürüme için Harita Yolunu Hesapla (Pathfinding)
    local path = PathfindingService:CreatePath({
        AgentRadius = 2, 
        AgentHeight = 5, 
        AgentCanJump = false, 
        WaypointSpacing = 3
    })
    
    local success, _ = pcall(function() path:ComputeAsync(hrp.Position, targetPos) end)
    
    if success and path.Status == Enum.PathStatus.Success then
        local waypoints = path:GetWaypoints()
        
        for _, wp in pairs(waypoints) do
            if _G.CancelWalk or not _G.Settings.AIBot then return false end
            if tick() - startTime > maxWait then return false end
            
            -- ✈️ SAFE FLY MODU: Yol üzerindeki noktaları 'FlyHeight' kadar yukarı kaydırır
            if _G.Settings.FlyMode then
                -- Karakterin eşyalara hafif takılmasını engelle
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end

                local targetElevated = Vector3.new(wp.Position.X, wp.Position.Y + _G.Settings.FlyHeight, wp.Position.Z)
                
                while (hrp.Position - targetElevated).Magnitude > 2.5 do
                    if _G.CancelWalk or not _G.Settings.AIBot then return false end
                    if tick() - startTime > maxWait then return false end
                    
                    local speed = _G.Settings.SafeWalkSpeed
                    local direction = (targetElevated - hrp.Position).Unit
                    
                    -- Koridor içinden süzülerek git (Dış duvarlara çarpmaz, geriye ışınlamaz)
                    hrp.CFrame = CFrame.new(hrp.Position + direction * (speed * 0.022), targetElevated)
                    task.wait(0.015)
                end
            else
                -- 🚶 NORMAL YÜRÜME MODU
                hum:MoveTo(wp.Position)
                local wpTimeout = tick()
                
                while (hrp.Position - wp.Position).Magnitude > 3 do
                    if tick() - wpTimeout > 2 or _G.CancelWalk or not _G.Settings.AIBot then break end
                    task.wait(0.02)
                end
            end
        end
        return true
    else
        -- Yedek Düz Hareket (Pathfinding başarısız olursa)
        if _G.Settings.FlyMode then
            local targetElevated = Vector3.new(targetPos.X, targetPos.Y + _G.Settings.FlyHeight, targetPos.Z)
            hrp.CFrame = CFrame.new(targetElevated)
        else
            hum:MoveTo(targetPos)
        end
        task.wait(0.2)
        return false
    end
end

local function GetCurrentRoom()
    local gameData = ReplicatedStorage:FindFirstChild("GameData")
    if gameData and gameData:FindFirstChild("LatestRoom") then
        local roomNum = tostring(gameData.LatestRoom.Value)
        local room = Workspace.CurrentRooms:FindFirstChild(roomNum)
        return room
    end
    return nil
end

local function GetActiveEntity()
    local rush = Workspace:FindFirstChild("RushMoving")
    local ambush = Workspace:FindFirstChild("AmbushMoving")
    if rush then return rush end
    if ambush then return ambush end
    return nil
end

local function IsSeekActive()
    return Workspace:FindFirstChild("SeekMoving") or Workspace:FindFirstChild("SeekRig")
end

local function FindKeyInRoom(room)
    if not room then return nil, nil end
    for _, obj in pairs(room:GetDescendants()) do
        local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            local text = prompt.ActionText:lower()
            if text:find("key") or text:find("grab") then
                local part = obj:FindFirstChildWhichIsA("BasePart", true)
                if part then return obj, prompt end
            end
        end
    end
    return nil, nil
end

local function FindBooksInRoom(room)
    local books = {}
    if not room then return books end
    for _, obj in pairs(room:GetDescendants()) do
        if obj.Name == "LiveHintBook" then table.insert(books, obj) end
    end
    return books
end

local function FindPaperInRoom(room)
    if not room then return nil, nil end
    for _, obj in pairs(room:GetDescendants()) do
        if obj.Name:find("Paper") or obj.Name:find("Hint") then
            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then return obj, prompt end
        end
    end
    return nil, nil
end

local function FindClosetInRoom(room, hrp)
    local bestCloset, bestDist = nil, math.huge
    if not room or not hrp then return nil end
    for _, obj in pairs(room:GetDescendants()) do
        if obj.Name:find("Wardrobe") or obj.Name:find("Locker") then
            local part = obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local dist = (hrp.Position - part.Position).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestCloset = obj
                end
            end
        end
    end
    return bestCloset
end

local function WaitForEntityTimeout(maxWait)
    maxWait = maxWait or 30
    local startTime = tick()
    while GetActiveEntity() and (tick() - startTime) < maxWait do
        task.wait(0.2)
    end
    return (tick() - startTime) < maxWait
end

