local function FindKeyInRoom(room)
    if not room then return nil, nil end
    
    local bestKey = nil
    local shortestDist = math.huge
    
    SafeExecute(function()
        for _, obj in pairs(room:GetDescendants()) do
            if obj.Name:find("Key") then
                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    local keyPart = obj:FindFirstChildWhichIsA("BasePart", true) or obj
                    local dist = Distance(GetHumanoidRootPart().Position, keyPart.Position)
                    if dist < shortestDist then
                        shortestDist = dist
                        bestKey = { obj = obj, prompt = prompt, part = keyPart }
                    end
                end
            end
        end
    end, "FindKeyInRoom")
    
    return bestKey
end

local function PickupKey(room)
    if not _G.Settings.AutoPickupKeys then return end
    
    local keyData = FindKeyInRoom(room)
    if not keyData then return end
    
    WalkToTarget(keyData.part.Position, 5, 2)
    task.wait(0.1)
    
    SafeExecute(function()
        if keyData.prompt.TriggerPrompt then
            keyData.prompt:TriggerPrompt()
        else
            fireproximityprompt(keyData.prompt)
        end
    end, "PickupKey")
    
    _G.Statistics.KeysCollected = _G.Statistics.KeysCollected + 1
    task.wait(0.3)
end

local function HasKey()
    if not Character then return false end
    return Character:FindFirstChild("Key") ~= nil or LocalPlayer.Backpack:FindFirstChild("Key") ~= nil
end

