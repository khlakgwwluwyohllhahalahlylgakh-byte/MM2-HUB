-- Canavar ve Varlık ESP Motoru
RunService.RenderStepped:Connect(function()
    if _G.Settings and _G.Settings.EntityESP then
        for _, v in pairs(Workspace:GetDescendants()) do
            if v.Name == "RushMoving" or v.Name == "AmbushMoving" or v.Name == "Figure" then
                if not v:FindFirstChild("DoorsESP") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "DoorsESP"
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.Parent = v
                end
            end
        end
    else
        for _, v in pairs(Workspace:GetDescendants()) do
            if v.Name == "DoorsESP" then v:Destroy() end
        end
    end
end)

-- AKILLI OTO-PLAY & YARATIK ALGILAMA SİSTEMİ (Dolaba Gir / Çık / Kapıya Git)
task.spawn(function()
    local currentlyHiding = false
    
    while true do
        task.wait(0.2)
        if _G.Settings and _G.Settings.AutoPlayMaster then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                -- 1. YARATIK TESPİTİ (Rush, Ambush vb.)
                local detectedDanger = nil
                for _, v in pairs(Workspace:GetChildren()) do
                    if v.Name == "RushMoving" or v.Name == "AmbushMoving" then
                        local vPart = v:FindFirstChild("Root") or v:FindFirstChildWhichIsA("BasePart")
                        if vPart and (hrp.Position - vPart.Position).Magnitude < 140 then
                            detectedDanger = v
                        end
                    end
                end

                -- 2. TEHLİKE VARSA DOLABA GİR
                if detectedDanger then
                    currentlyHiding = true
                    for _, room in pairs(Workspace.CurrentRooms:GetChildren()) do
                        local assets = room:FindFirstChild("Assets")
                        if assets then
                            for _, obj in pairs(assets:GetChildren()) do
                                if obj.Name:lower():find("wardrobe") or obj.Name:lower():find("closet") then
                                    local doorPart = obj:FindFirstChild("Door") or obj:FindFirstChildWhichIsA("BasePart")
                                    if doorPart and (hrp.Position - doorPart.Position).Magnitude < 60 then
                                        hrp.CFrame = doorPart.CFrame
                                    end
                                end
                            end
                        end
                    end
                else
                    -- 3. TEHLİKE GEÇTİYSE DOLAPTAN ÇIK VE KAPILARA İLERLE
                    if currentlyHiding then
                        currentlyHiding = false
                        hrp.CFrame = hrp.CFrame + Vector3.new(3, 0, 3)
                        task.wait(0.6)
                    end

                    -- Kapı açma ve ilerleme
                    if Workspace:FindFirstChild("CurrentRooms") then
                        for _, room in pairs(Workspace.CurrentRooms:GetChildren()) do
                            local door = room:FindFirstChild("Door")
                            if door then
                                local knob = door:FindFirstChild("Knob")
                                if knob and (hrp.Position - knob.Position).Magnitude < 50 then
                                    hrp.CFrame = knob.CFrame + Vector3.new(0, 0, 2)
                                end
                            end
                        end
                    end

                    -- Anahtar toplama
                    if _G.Settings.AutoKey then
                        for _, room in pairs(Workspace.CurrentRooms:GetChildren()) do
                            local assets = room:FindFirstChild("Assets")
                            if assets then
                                for _, item in pairs(assets:GetChildren()) do
                                    if item.Name == "Key" or item.Name:lower():find("key") then
                                        local hitbox = item:FindFirstChild("Hitbox") or item:FindFirstChildWhichIsA("BasePart")
                                        if hitbox and (hrp.Position - hitbox.Position).Magnitude < 40 then
                                            hrp.CFrame = hitbox.CFrame
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

