-- Güvenli Yol Bulma (Duvarlara Çarpmadan Yürüme)
local function SmartWalk(targetPos, maxWait)
    maxWait = maxWait or 5
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if not hum or not hrp then 
        Log("SmartWalk: Character bulunamadı")
        return false 
    end
    
    _G.CancelWalk = false
    local startTime = tick()
    
    local path = PathfindingService:CreatePath({
        AgentRadius = 2, 
        AgentHeight = 5, 
        AgentCanJump = false, 
        WaypointSpacing = 3
    })
    
    local success, _ = pcall(function() path:ComputeAsync(hrp.Position, targetPos) end)
    
    if success and path.Status == Enum.PathStatus.Success then
        Log("Yol bulundu, hareket başlıyor")
        for _, wp in pairs(path:GetWaypoints()) do
            if _G.CancelWalk or not _G.Settings.AIBot then 
                Log("SmartWalk iptal edildi")
                return false 
            end
            
            if tick() - startTime > maxWait then
                Log("SmartWalk timeout")
                return false
            end
            
            hum:MoveTo(wp.Position)
            local wpTimeout = tick()
            
            while (hrp.Position - wp.Position).Magnitude > 5 do
                if tick() - wpTimeout > 3 or _G.CancelWalk or not _G.Settings.AIBot then break end
                task.wait(0.05)
            end
        end
        Log("SmartWalk tamamlandı")
        return true
    else
        Log("Path başarısız, direktly hareket etme")
        hum:MoveTo(targetPos)
        task.wait(0.4)
        return false
    end
end

-- Aktif Odayı Bulma
local function GetCurrentRoom()
    local gameData = ReplicatedStorage:FindFirstChild("GameData")
    if gameData and gameData:FindFirstChild("LatestRoom") then
        local roomNum = tostring(gameData.LatestRoom.Value)
        local room = Workspace.CurrentRooms:FindFirstChild(roomNum)
        Log("Aktif oda: " .. roomNum)
        return room
    end
    return nil
end

-- Yaratık Algılayıcı (Rush & Ambush)
local function GetActiveEntity()
    local rush = Workspace:FindFirstChild("RushMoving")
    local ambush = Workspace:FindFirstChild("AmbushMoving")
    if rush then return rush end
    if ambush then return ambush end
    return nil
end

-- Seek Algılayıcı
local function IsSeekActive()
    return Workspace:FindFirstChild("SeekMoving") or Workspace:FindFirstChild("SeekRig")
end

-- Anahtar Bulma (Geliştirilmiş)
local function FindKeyInRoom(room)
    if not room then return nil, nil end
    
    for _, obj in pairs(room:GetDescendants()) do
        local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            local text = prompt.ActionText:lower()
            if text:find("key") or text:find("grab") then
                local part = obj:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    Log("Anahtar bulundu: " .. obj.Name)
                    return obj, prompt
                end
            end
        end
    end
    
    for _, obj in pairs(room:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:find("Key") or obj.Name:find("KeyObtain")) then
            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            local part = obj:FindFirstChildWhichIsA("BasePart", true)
            if prompt and part then
                Log("Anahtar bulundu (fallback): " .. obj.Name)
                return obj, prompt
            end
        end
    end
    
    return nil, nil
end

-- Kitap Bulma (Kütüphane)
local function FindBooksInRoom(room)
    local books = {}
    if not room then return books end
    
    for _, obj in pairs(room:GetDescendants()) do
        if obj.Name == "LiveHintBook" then
            table.insert(books, obj)
        end
    end
    Log("Kitaplar bulundu: " .. #books)
    return books
end

-- Kağıt Bulma (Şifre)
local function FindPaperInRoom(room)
    if not room then return nil, nil end
    
    for _, obj in pairs(room:GetDescendants()) do
        if obj.Name:find("Paper") or obj.Name:find("Hint") then
            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                Log("Kağıt bulundu: " .. obj.Name)
                return obj, prompt
            end
        end
    end
    return nil, nil
end

-- Dolap Bulma (Ambush/Rush saklanma)
local function FindClosetInRoom(room, hrp)
    local bestCloset, bestDist = nil, math.huge
    
    if not room or not hrp then return nil end
    
    for _, obj in pairs(room:GetDescendants()) do
        if obj.Name:find("Wardrobe") or obj.Name:find("Locker") then
            local part = obj:FindFirstChildWhichIsA("BasePart")
            if part then
                local dist = (hrp.Position - part.Position).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestCloset = obj
                end
            end
        end
    end
    
    if bestCloset then
        Log("Dolap bulundu, mesafe: " .. string.format("%.1f", bestDist))
    end
    return bestCloset
end

-- Safe Timeout ile Entity Bekleme
local function WaitForEntityTimeout(maxWait)
    maxWait = maxWait or 30
    local startTime = tick()
    
    while GetActiveEntity() and (tick() - startTime) < maxWait do
        task.wait(0.2)
    end
    
    if (tick() - startTime) >= maxWait then
        Log("Entity bekleme timeout!")
        return false
    end
    
    Log("Yaratık gitti")
    return true
end

