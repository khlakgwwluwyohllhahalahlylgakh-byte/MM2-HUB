local currentTween = nil

-- Noclip (Duvarlardan geçme) döngüsü
RunService.Stepped:Connect(function()
    if _G.Settings.AIBot and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- Pürüzsüz Süzülme Fonksiyonu
local function GlideTo(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if currentTween then currentTween:Cancel() end
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local timeToTravel = distance / _G.Settings.GlideSpeed
    
    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
    currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    currentTween:Play()
    
    return timeToTravel
end

-- Yaratık Kontrolü
local function IsEntityComing()
    for _, v in pairs(Workspace:GetChildren()) do
        if v.Name == "RushMoving" or v.Name == "AmbushMoving" then
            return true
        end
    end
    return false
end

-- En son odayı bulma
local function GetCurrentRoom()
    local gameData = ReplicatedStorage:FindFirstChild("GameData")
    if gameData and gameData:FindFirstChild("LatestRoom") then
        local roomNum = gameData.LatestRoom.Value
        return Workspace.CurrentRooms:FindFirstChild(tostring(roomNum))
    end
    return nil
end

-- Yapay Zeka Ana Döngüsü
task.spawn(function()
    local isHiding = false
    
    while task.wait(0.1) do
        if not _G.DoorsAI_Running then break end
        
        if _G.Settings.AIBot then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                char:FindFirstChild("Humanoid").PlatformStand = true -- Süzülürken yürümeyi kapat
                
                local room = GetCurrentRoom()
                if not room then return end

                -- [ÖNCELİK 1]: YARATIK KONTROLÜ
                if IsEntityComing() then
                    if not isHiding then
                        -- En yakın dolabı bul
                        local bestCloset, bestDist = nil, math.huge
                        for _, obj in pairs(room:GetDescendants()) do
                            if obj.Name:find("Wardrobe") or obj.Name:find("Rooms_Locker") then
                                local door = obj:FindFirstChild("Door") or obj:FindFirstChild("Hidden") or obj:FindFirstChildWhichIsA("BasePart")
                                if door then
                                    local dist = (hrp.Position - door.Position).Magnitude
                                    if dist < bestDist then
                                        bestDist = dist
                                        bestCloset = obj
                                    end
                                end
                            end
                        end
                        
                        if bestCloset then
                            local prompt = bestCloset:FindFirstChildWhichIsA("ProximityPrompt", true)
                            local part = bestCloset:FindFirstChildWhichIsA("BasePart", true)
                            if part and prompt then
                                GlideTo(part.CFrame * CFrame.new(0, 0, 2))
                                task.wait(0.5)
                                fireproximityprompt(prompt)
                                isHiding = true
                            end
                        end
                    end
                    return -- Yaratık varken başka bir şey yapma
                end
                
                -- Yaratık gitti, dolaptan çık
                if isHiding and not IsEntityComing() then
                    task.wait(1.5) -- Yaratığın tamamen gitmesi için kısa bekleme
                    hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -5)
                    isHiding = false
                    return
                end

                -- [ÖNCELİK 2 & 3]: KAPI VE ANAHTAR MANTIĞI
                if not isHiding then
                    local door = room:FindFirstChild("Door")
                    if door then
                        local lock = door:FindFirstChild("Lock")
                        
                        -- Envanterde anahtar var mı bak
                        local hasKey = char:FindFirstChild("Key") or (char.Parent == Workspace and LocalPlayer.Backpack:FindFirstChild("Key"))
                        
                        if lock and not hasKey then
                            -- Kilitli ve anahtarımız yok: Anahtarı bul ve al
                            local keyObj = room:FindFirstChild("KeyObtain", true)
                            if keyObj then
                                local prompt = keyObj:FindFirstChildWhichIsA("ProximityPrompt")
                                if prompt then
                                    GlideTo(keyObj.CFrame)
                                    task.wait(0.2)
                                    fireproximityprompt(prompt)
                                end
                            end
                        else
                            -- Kilidi yok veya anahtarımız zaten var: Kapıya git
                            local doorPart = door:FindFirstChild("Door") or door:FindFirstChildWhichIsA("BasePart")
                            if doorPart then
                                -- Kapı promptunu veya kilidini bul
                                local prompt = doorPart.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
                                
                                -- Kilitliyse elimize anahtarı alalım
                                if lock and hasKey then
                                    local keyTool = LocalPlayer.Backpack:FindFirstChild("Key")
                                    if keyTool then
                                        char.Humanoid:EquipTool(keyTool)
                                    end
                                    prompt = lock:FindFirstChildWhichIsA("ProximityPrompt", true)
                                end
                                
                                GlideTo(doorPart.CFrame * CFrame.new(0, 1, 0))
                                task.wait(0.2)
                                
                                if prompt then
                                    fireproximityprompt(prompt)
                                end
                                -- Çarparak açılan kapılar için touch
                                firetouchinterest(char.HumanoidRootPart, doorPart, 0)
                                task.wait(0.05)
                                firetouchinterest(char.HumanoidRootPart, doorPart, 1)
                            end
                        end
                    end
                end
            end)
        else
            -- AI Kapalıysa karakteri normale döndür
            pcall(function()
                if currentTween then currentTween:Cancel(); currentTween = nil end
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") then
                    char.Humanoid.PlatformStand = false
                end
            end)
        end
    end
end)

