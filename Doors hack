    ShapeNumbers = {},
    Password = ""
}

local function ScanLibraryShapeOrder()
    _LibraryData.ShapeOrder = {}
    
    SafeExecute(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            for _, screen in pairs(playerGui:GetDescendants()) do
                if screen:IsA("Frame") or screen:IsA("ImageLabel") then
                    if screen.Name:find("Heart") or screen.Name:find("Hint") then
                        local shapeName = screen.Name
                        if shapeName:find("Circle") then table.insert(_LibraryData.ShapeOrder, "Circle")
                        elseif shapeName:find("Square") then table.insert(_LibraryData.ShapeOrder, "Square")
                        elseif shapeName:find("Triangle") then table.insert(_LibraryData.ShapeOrder, "Triangle")
                        elseif shapeName:find("Star") then table.insert(_LibraryData.ShapeOrder, "Star")
                        elseif shapeName:find("Diamond") then table.insert(_LibraryData.ShapeOrder, "Diamond")
                        elseif shapeName:find("Cross") then table.insert(_LibraryData.ShapeOrder, "Cross")
                        elseif shapeName:find("Pentagon") then table.insert(_LibraryData.ShapeOrder, "Pentagon")
                        elseif shapeName:find("Hexagon") then table.insert(_LibraryData.ShapeOrder, "Hexagon")
                        end
                    end
                end
            end
        end
    end, "ScanLibraryShapeOrder")
    
    Log("📚 Shape Order Tarandı: " .. table.concat(_LibraryData.ShapeOrder, ", "), "LIBRARY")
end

local function ReadLibraryBooks(room)
    if not room then return end
    
    _LibraryData.ShapeNumbers = {}
    
    SafeExecute(function()
        local books = {}
        for _, obj in pairs(room:GetDescendants()) do
            if obj.Name:find("Book") or obj.Name:find("Hint") then
                table.insert(books, obj)
            end
        end
        
        for _, book in pairs(books) do
            local prompt = book:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                local bookPart = book:FindFirstChildWhichIsA("BasePart", true) or book
                
                -- Kitabı oku
                WalkToTarget(bookPart.Position, 5, 2)
                task.wait(0.1)
                
                if prompt.TriggerPrompt then
                    prompt:TriggerPrompt()
                else
                    fireproximityprompt(prompt)
                end
                
                task.wait(0.3)
                
                -- GUI'den bilgi oku
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if playerGui then
                    for _, textObj in pairs(playerGui:GetDescendants()) do
                        if textObj:IsA("TextLabel") then
                            local text = textObj.Text:lower()
                            local number = text:match("%d+")
                            
                            if number and (text:find("circle") or text:find("square") or text:find("triangle") 
                                or text:find("star") or text:find("diamond") or text:find("cross")
                                or text:find("pentagon") or text:find("hexagon")) then
                                
                                if text:find("circle") then _LibraryData.ShapeNumbers["Circle"] = tonumber(number)
                                elseif text:find("square") then _LibraryData.ShapeNumbers["Square"] = tonumber(number)
                                elseif text:find("triangle") then _LibraryData.ShapeNumbers["Triangle"] = tonumber(number)
                                elseif text:find("star") then _LibraryData.ShapeNumbers["Star"] = tonumber(number)
                                elseif text:find("diamond") then _LibraryData.ShapeNumbers["Diamond"] = tonumber(number)
                                elseif text:find("cross") then _LibraryData.ShapeNumbers["Cross"] = tonumber(number)
                                elseif text:find("pentagon") then _LibraryData.ShapeNumbers["Pentagon"] = tonumber(number)
                                elseif text:find("hexagon") then _LibraryData.ShapeNumbers["Hexagon"] = tonumber(number)
                                end
                            end
                        end
                    end
                end
                
                task.wait(0.2)
            end
        end
    end, "ReadLibraryBooks")
    
    Log("📚 Kitaplar Okundu: " .. table.concat(_LibraryData.ShapeNumbers, ", "), "LIBRARY")
end

local function GenerateLibraryPassword()
    _LibraryData.Password = ""
    
    for _, shape in pairs(_LibraryData.ShapeOrder) do
        if _LibraryData.ShapeNumbers[shape] then
            _LibraryData.Password = _LibraryData.Password .. tostring(_LibraryData.ShapeNumbers[shape])
        end
    end
    
    Log("📚 Şifre Üretildi: " .. _LibraryData.Password, "LIBRARY")
    return _LibraryData.Password
end

local function SolveLibrary(room)
    if not room or room.Name ~= "50" then return false end
    
    Log("🔐 Kütüphane Çözme Başladı...", "LIBRARY")
    
    local hrp = GetHumanoidRootPart()
    local humanoid = GetHumanoid()
    if not hrp or not humanoid then return false end
    
    if _G.Settings.AutoSolveLibrary then
        -- Eğilme animasyonunu başlat
        SafeExecute(function()
            ReplicatedStorage.RemotesFolder.Crouch:FireServer(true)
        end, "LibraryCrouch")
        
        task.wait(0.3)
        
        -- Kağıt oku (hint)
        SafeExecute(function()
            for _, obj in pairs(room:GetDescendants()) do
                if obj.Name:find("Paper") or obj.Name:find("Hint") then
                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then
                        WalkToTarget(obj.Position, 5, 2)
                        task.wait(0.1)
                        if prompt.TriggerPrompt then
                            prompt:TriggerPrompt()
                        else
                            fireproximityprompt(prompt)
                        end
                        task.wait(0.2)
                    end
                end
            end
        end, "ReadPaper")
        
        task.wait(0.2)
        
        -- Shape order'ı tara
        ScanLibraryShapeOrder()
        task.wait(0.3)
        
        -- Kitapları oku
        ReadLibraryBooks(room)
        task.wait(0.3)
        
        -- Şifreyi oluştur
        local password = GenerateLibraryPassword()
        
        if password and password ~= "" then
            -- Kilit bul ve şifreyi gir
            SafeExecute(function()
                local padlock = room:FindFirstChild("Padlock") or room:FindFirstChild("Lock")
                if padlock then
                    local lockPart = padlock:FindFirstChildWhichIsA("BasePart", true)
                    if lockPart then
                        WalkToTarget(lockPart.Position, 5, 2)
                        task.wait(0.2)
                        
                        ReplicatedStorage.RemotesFolder.PL:FireServer(password)
                        Success("✅ Şifre Gönderildi: " .. password)
                        _G.Statistics.LibrarariesSolved = _G.Statistics.LibrarariesSolved + 1
                    end
                end
            end, "EnterPassword")
        else
            Error("Şifre oluşturulamadı!", false)
        end
        
        task.wait(0.3)
        
        -- Eğilme animasyonunu bitir
        SafeExecute(function()
            ReplicatedStorage.RemotesFolder.Crouch:FireServer(false)
        end, "LibraryCrouchEnd")
    end
    
    return true
end

