    _G.Settings.Godmode = false
    _G.Settings.XRay = false
    _G.Settings.DoorESP = false
    _G.Settings.KeyESP = false
    _G.Settings.ClosetESP = false
    _G.Settings.ItemESP = false
    _G.Settings.HighlightEntities = false

    -- Tüm Workspace içi özel Highlight nesnelerini temizle
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "DoorHighlight" or obj.Name == "KeyHighlight" or obj.Name == "ClosetHighlight" or obj.Name == "ItemHighlight" then
            obj:Destroy()
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            local h = player.Character:FindFirstChild("Highlight")
            if h then h:Destroy() end
        end
    end

    if Character and Humanoid then
        Humanoid.WalkSpeed = 16
    end
end

-- ==================== YARDIMCI FONKSİYONLAR ====================
local function Log(message, level)
    if _G.Settings.DebugMode or _G.Settings.VerboseLogging then
        print(string.format("[DOORS AI v37] [%s] %s", level or "INFO", message))
    end
end

local function ErrorHandler(err)
    _G.Statistics.Errors = _G.Statistics.Errors + 1
    _G.DoorsAI.LastError = err
    warn("[DOORS AI ERROR] " .. tostring(err))
    if not _G.Settings.SafeMode then error(err) end
end

local function SafeExecute(func, errorName)
    local success, result = pcall(func)
    if not success then
        ErrorHandler("[" .. (errorName or "Unknown") .. "] " .. tostring(result))
    end
    return success, result
end

local function Distance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

local function GetCharacterPosition()
    if Character and HumanoidRootPart then
        return HumanoidRootPart.Position
    end
    return Vector3.new(0, 0, 0)
end

local function GetClosest(targets, fromPos)
    fromPos = fromPos or GetCharacterPosition()
    local closest, closestDist = nil, math.huge
    for _, obj in ipairs(targets) do
        local pos = obj.Position or (obj:IsA("BasePart") and obj.Position) or nil
        if pos then
            local dist = Distance(fromPos, pos)
            if dist < closestDist then
                closestDist = dist
                closest = obj
            end
        end
    end
    return closest, closestDist
end

local function SmoothMoveTo(targetPos, speedOverride, stopDist)
    speedOverride = speedOverride or _G.Settings.MoveSpeed
    stopDist = stopDist or 2.5
    if not Character or not HumanoidRootPart then return false end
    local currentPos = HumanoidRootPart.Position
    local dist = Distance(currentPos, targetPos)
    if dist < stopDist then return true end
    local direction = (targetPos - currentPos).Unit
    local newPos = currentPos + direction * math.min(speedOverride * 0.1, dist)
    HumanoidRootPart.CFrame = CFrame.new(newPos, targetPos + Vector3.new(0, 1, 0))
    return false
end

-- ==================== ODA / KAPI / EŞYA BULMA ====================
local function GetCurrentRoom()
    local success, gData = pcall(function() return ReplicatedStorage:FindFirstChild("GameData") end)
    if success and gData and gData:FindFirstChild("LatestRoom") then
        local roomNum = gData.LatestRoom.Value
        _G.GameState.CurrentRoomNumber = roomNum
        local rooms = Workspace:FindFirstChild("Rooms")
        if rooms then
            local room = rooms:FindFirstChild(tostring(roomNum))
            if room then
                _G.GameState.CurrentRoom = room
                return room, roomNum
            end
        end
    end
    return nil, 0
end

local function FindDoorInRoom(room)
    if not room then return nil end
    for _, child in ipairs(room:GetDescendants()) do
        if child:IsA("BasePart") and child.Name:lower():find("door") then
            local door = child.Parent
            if door and door:FindFirstChild("Door") then
                return door
            end
        end
    end
    return nil
end

local function FindClosetInRoom(room)
    if not room then return nil end
    for _, child in ipairs(room:GetDescendants()) do
        if child.Name:lower():find("closet") or child.Name:lower():find("wardrobe") then
            if child:IsA("BasePart") then
                return child
            end
        end
    end
    return nil
end

local function FindItemsInRoom(room)
    local items = {}
    if not room then return items end
    for _, child in ipairs(room:GetDescendants()) do
        if child:IsA("BasePart") then
            local name = child.Name:lower()
            if name:find("health") or name:find("battery") or name:find("gold") or name:find("coin") or name:find("vitamin") then
                table.insert(items, child)
            end
        end
    end
    return items
end

-- ==================== DÜŞMAN ALGILAMA ====================
local function DetectEntities()
    local entities = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("rush") or name:find("ambush") or name:find("seek") or
               name:find("eyes") or name:find("screech") or name:find("figure") or
               name:find("hide") or name:find("dupe") or name:find("snare") then
                table.insert(entities, obj)
            end
        end
    end
    return entities
end

local function IsDangerousEntity(entity)
    local name = entity.Name:lower()
    return name:find("rush") or name:find("ambush") or name:find("seek") or
           name:find("eyes") or name:find("screech") or name:find("figure") or
           name:find("hide") or name:find("dupe")
end

local function GetEntityDistance(entity)
    local charPos = GetCharacterPosition()
    local entPos = entity.Position or (entity:IsA("BasePart") and entity.Position)
    if entPos then
        return Distance(charPos, entPos)
    end
    return math.huge
end

-- ==================== DOLAP & SAKLANMA ====================
local function GetClosestCloset()
    local room, _ = GetCurrentRoom()
    if room then
        local closet = FindClosetInRoom(room)
        if closet then return closet end
    end
    local allClosets = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:lower():find("closet") or obj.Name:lower():find("wardrobe")) then
            table.insert(allClosets, obj)
        end
    end
    return GetClosest(allClosets)
end

local function HideInCloset()
    if _G.GameState.IsHiding then return true end
    local closet = GetClosestCloset()
    if closet then
        local closetPos = closet.Position
        local dist = Distance(GetCharacterPosition(), closetPos)
        if dist < 5 then
            local prompt = closet.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                fireproximityprompt(prompt)
                _G.GameState.IsHiding = true
                _G.Statistics.TimesHidden = _G.Statistics.TimesHidden + 1
                return true
            end
        else
            SmoothMoveTo(closetPos, _G.Settings.SprintSpeed)
        end
    end
    return false
end

local function LeaveCloset()
    if not _G.GameState.IsHiding then return end
    local closet = GetClosestCloset()
    if closet then
        local prompt = closet.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            fireproximityprompt(prompt)
            _G.GameState.IsHiding = false
        end
    end
end

-- ==================== KÜTÜPHANE ÇÖZÜCÜ ====================
local function SolveLibraryPuzzle()
    if not _G.Settings.AutoSolveLibrary then return end
    local room, roomNum = GetCurrentRoom()
    if roomNum ~= 50 then return end

    local books = {}
    for _, obj in ipairs(room:GetDescendants()) do
        if obj.Name:lower():find("book") and obj:IsA("BasePart") then
            table.insert(books, obj)
        end
    end

    if #books == 0 then
        for _, prompt in ipairs(room:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                fireproximityprompt(prompt)
                task.wait(0.1)
            end
        end
        return
    end

    for i, book in ipairs(books) do
        local prompt = book.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            fireproximityprompt(prompt)
            task.wait(0.2)
        end
    end
    _G.Statistics.LibrariesSolved = _G.Statistics.LibrariesSolved + 1
end

-- ==================== SAĞLIK & EŞYA ====================
local function UseHealItem()
    if not _G.Settings.AutoUseHeal then return end
    if Humanoid and Humanoid.Health < Humanoid.MaxHealth * 0.5 then
        local room, _ = GetCurrentRoom()
        if room then
            local items = FindItemsInRoom(room)
            for _, item in ipairs(items) do
                if item.Name:lower():find("health") or item.Name:lower():find("vitamin") then
                    local dist = Distance(GetCharacterPosition(), item.Position)
                    if dist < 5 then
                        local prompt = item.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt then
                            fireproximityprompt(prompt)
                            _G.Statistics.HealsUsed = _G.Statistics.HealsUsed + 1
                            return true
                        end
                    else
                        SmoothMoveTo(item.Position, _G.Settings.SprintSpeed)
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- ==================== OTOMASYON ADIMI ====================
local function AutomateStep()
    if not _G.Settings.AIEnabled then return end
    local charPos = GetCharacterPosition()
    local room, roomNum = GetCurrentRoom()
    if not room then return end

    if _G.Settings.AutoUseHeal then
        if UseHealItem() then return end
    end

    if roomNum == 50 then
        SolveLibraryPuzzle()
        return
    end

    local entities = DetectEntities()
    local dangerDetected = false
    local dangerDistance = _G.Settings.AvoidanceDistance
    for _, entity in ipairs(entities) do
        if IsDangerousEntity(entity) then
            local dist = GetEntityDistance(entity)
            if dist < dangerDistance then
                dangerDetected = true
                _G.GameState.ThreatLevel = math.max(_G.GameState.ThreatLevel, 1)
                _G.GameState.ActiveEntity = entity
                _G.GameState.EntityType = entity.Name

                if _G.Settings.AutoHide then
                    if HideInCloset() then
                        _G.Statistics.EntitiesAvoided = _G.Statistics.EntitiesAvoided + 1
                        return
                    end
                end

                local escapeTarget = GetClosestCloset()
                if escapeTarget then
                    SmoothMoveTo(escapeTarget.Position, _G.Settings.SprintSpeed)
                else
                    local awayDir = (charPos - entity.Position).Unit
                    local target = charPos + awayDir * 30
                    SmoothMoveTo(target, _G.Settings.SprintSpeed)
                end
                return
            end
        end
    end

    if not dangerDetected then
        _G.GameState.ThreatLevel = 0
        _G.GameState.ActiveEntity = nil
        _G.GameState.EntityType = nil
        if _G.GameState.IsHiding then
            LeaveCloset()
        end
    end

    if _G.Settings.AutoPickupItems then
        local items = FindItemsInRoom(room)
        for _, item in ipairs(items) do
            local dist = Distance(charPos, item.Position)
            if dist < 5 then
                local prompt = item.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    fireproximityprompt(prompt)
                    _G.Statistics.ItemsCollected = _G.Statistics.ItemsCollected + 1
                    if item.Name:lower():find("key") then
                        _G.Statistics.KeysCollected = _G.Statistics.KeysCollected + 1
                        _G.GameState.HasKey = true
                    end
                end
            else
                if not FindDoorInRoom(room) or Distance(charPos, FindDoorInRoom(room).Position) > 10 then
                    SmoothMoveTo(item.Position, _G.Settings.MoveSpeed)
                    return
                end
            end
        end
    end

    if _G.Settings.AutoOpenDoors then
        local door = FindDoorInRoom(room)
        if door then
            local doorPart = door:FindFirstChild("Door")
            if doorPart and doorPart:IsA("BasePart") then
                local doorPos = doorPart.Position
                local dist = Distance(charPos, doorPos)
                if dist < 5 then
                    local prompt = door:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then
                        fireproximityprompt(prompt)
                        _G.Statistics.DoorsOpened = _G.Statistics.DoorsOpened + 1
                    end
                else
                    SmoothMoveTo(doorPos, _G.Settings.MoveSpeed)
                    return
                end
            end
        end
    end

    if _G.Settings.AutoProgress then
        local nextRoom = Workspace.Rooms:FindFirstChild(tostring(roomNum + 1))
        if nextRoom then
            local door = FindDoorInRoom(room)
            if door and door:FindFirstChild("Door") and door.Door.Transparency > 0.5 then
                local nextPos = nextRoom:FindFirstChild("Spawn") or nextRoom:FindFirstChild("Floor")
                if nextPos then
                    SmoothMoveTo(nextPos.Position, _G.Settings.SprintSpeed)
                    _G.Statistics.RoomsCompleted = _G.Statistics.RoomsCompleted + 1
                end
            end
        end
    end

    if _G.Settings.AntiAFK then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end

-- ==================== GÖRSELLER ====================
local function SetupVisuals()
    if _G.Settings.Fullbright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 12
        Lighting.FogEnd = 1000
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.new(1, 1, 1)
    end

    if _G.Settings.XRay then
        for _, part in ipairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") and part.Name:lower():find("wall") then
                part.Transparency = 0.3
                part.CanCollide = false
            end
        end
    end

    if _G.Settings.HighlightEntities then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                if char then
                    local highlight = char:FindFirstChild("Highlight") or Instance.new("Highlight")
                    highlight.Parent = char
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                end
            end
        end
    end

    if _G.Settings.DoorESP then
        for _, door in ipairs(Workspace:GetDescendants()) do
            if door.Name:lower():find("door") and door:IsA("BasePart") then
                local highlight = door:FindFirstChild("DoorHighlight") or Instance.new("Highlight")
                highlight.Parent = door
                highlight.FillColor = Color3.fromRGB(0, 255, 0)
                highlight.FillTransparency = 0.3
                highlight.Name = "DoorHighlight"
            end
        end
    end

    if _G.Settings.KeyESP then
        for _, key in ipairs(Workspace:GetDescendants()) do
            if key.Name:lower():find("key") and key:IsA("BasePart") then
                local highlight = key:FindFirstChild("KeyHighlight") or Instance.new("Highlight")
                highlight.Parent = key
                highlight.FillColor = Color3.fromRGB(255, 255, 0)
                highlight.FillTransparency = 0.3
                highlight.Name = "KeyHighlight"
            end
        end
    end

    if _G.Settings.ClosetESP then
        for _, closet in ipairs(Workspace:GetDescendants()) do
            if (closet.Name:lower():find("closet") or closet.Name:lower():find("wardrobe")) and closet:IsA("BasePart") then
                local highlight = closet:FindFirstChild("ClosetHighlight") or Instance.new("Highlight")
                highlight.Parent = closet
                highlight.FillColor = Color3.fromRGB(0, 0, 255)
                highlight.FillTransparency = 0.3
                highlight.Name = "ClosetHighlight"
            end
        end
    end

    if _G.Settings.ItemESP then
        for _, item in ipairs(Workspace:GetDescendants()) do
            if item:IsA("BasePart") then
                local name = item.Name:lower()
                if name:find("health") or name:find("battery") or name:find("gold") or name:find("coin") or name:find("vitamin") then
                    local highlight = item:FindFirstChild("ItemHighlight") or Instance.new("Highlight")
                    highlight.Parent = item
                    highlight.FillColor = Color3.fromRGB(255, 0, 255)
                    highlight.FillTransparency = 0.3
                    highlight.Name = "ItemHighlight"
                end
            end
        end
    end
end

