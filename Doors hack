-- HIDIDING SYSTEM (Closet/Wardrobe)
-- ==========================================================
local function FindHidingSpot(room, hrp)
    if not room or not hrp then return nil, nil end
    
    local bestHiding = nil
    local shortestDist = math.huge
    
    SafeExecute(function()
        for _, obj in pairs(room:GetDescendants()) do
            if obj.Name:find("Wardrobe") or obj.Name:find("Locker") or obj.Name:find("Cabinet") or obj.Name:find("Closet") then
                local part = obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    local dist = Distance(hrp.Position, part.Position)
                    if dist < shortestDist and dist < 50 then
                        shortestDist = dist
                        bestHiding = obj
                    end
                end
            end
        end
    end, "FindHidingSpot")
    
    if bestHiding then
        local hidingPart = bestHiding:FindFirstChildWhichIsA("BasePart", true)
        local prompt = bestHiding:FindFirstChildWhichIsA("ProximityPrompt", true)
        return bestHiding, { part = hidingPart, prompt = prompt }
    end
    
    return nil, nil
end

local function HideInCloset(room, hrp)
    if not room or not hrp or not _G.Settings.AutoHideInClosets then return false end
    
    Log("🚪 Gizli yer aranıyor...", "ACTION")
    
    local hidingObj, hidingData = FindHidingSpot(room, hrp)
    if not hidingObj or not hidingData.part or not hidingData.prompt then
        Log("❌ Gizli yer bulunamadı!", "WARNING")
        return false
    end
    
    -- Gizli yere git
    WalkToTarget(hidingData.part.Position, 15, 2)
    task.wait(0.2)
    
    -- Prompt'u tetikle
    SafeExecute(function()
        if hidingData.prompt.TriggerPrompt then
            hidingData.prompt:TriggerPrompt()
        else
            fireproximityprompt(hidingData.prompt)
        end
    end, "HidePrompt")
    
    _G.GameState.IsHiding = true
    _G.Statistics.TimesHidden = _G.Statistics.TimesHidden + 1
    Success("🚪 Gizli yere kaçıldı!")
    
    return true
end

-- ==========================================================
-- SMOOTH MOVEMENT SYSTEM
-- ==========================================================
local function WalkToTarget(targetPos, timeout, stoppingDistance)
    timeout = timeout or 10
    stoppingDistance = stoppingDistance or 3
    
    local hrp = GetHumanoidRootPart()
    local humanoid = GetHumanoid()
    
    if not hrp or not humanoid then return false end
    
    humanoid.WalkSpeed = _G.Settings.WalkSpeed
    humanoid:MoveTo(targetPos)
    
    local startTime = tick()
    while Distance(hrp.Position, targetPos) > stoppingDistance do
        if not _G.Settings.AIEnabled or tick() - startTime > timeout or not hrp or not hrp.Parent then
            humanoid.WalkSpeed = 16
            return false
        end
        task.wait(0.05)
    end
    
    humanoid.WalkSpeed = 16
    return true
end

local function FlyToTarget(targetPos, timeout, altitude)
    altitude = altitude or _G.Settings.FlyHeight
    timeout = timeout or 10
    
    local hrp = GetHumanoidRootPart()
    if not hrp then return false end
    
    local targetElevated = Vector3.new(targetPos.X, targetPos.Y + altitude, targetPos.Z)
    local startTime = tick()
    
    while Distance(hrp.Position, targetElevated) > 3 do
        if not _G.Settings.AIEnabled or tick() - startTime > timeout or not hrp or not hrp.Parent then
            return false
        end
        
        local direction = (targetElevated - hrp.Position).Unit
        hrp.CFrame = CFrame.new(hrp.Position + direction * (_G.Settings.WalkSpeed * 0.022))
        task.wait(0.015)
    end
    
    return true
end

