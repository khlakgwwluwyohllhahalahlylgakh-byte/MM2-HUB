-- 🛡️ MUTLAK ÖLÜMSÜZLÜK VE ANA DÖNGÜ (RENDERSTEPPED)
-- ==========================================================
RunService.RenderStepped:Connect(function()
    -- 1. Mutlak Ölümsüzlük Motoru (True Godmode)
    if _G.Settings.Godmode and Humanoid then
        pcall(function()
            Humanoid.Health = Humanoid.MaxHealth
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            if HumanoidRootPart.Position.Y < -40 then
                HumanoidRootPart.CFrame = HumanoidRootPart.CFrame + Vector3.new(0, 60, 0)
            end
        end)
    end

    if not _G.Settings.AIEnabled then return end

    -- 2. Tehdit Yönetimi (Entity Priority)
    local threatDetected, entity = DetectThreat()
    if threatDetected then
        _G.Statistics.EntitiesAvoided = _G.Statistics.EntitiesAvoided + 1
        if entity.Name == "RushMoving" or entity.Name == "AmbushMoving" then
            HideInCloset()
        elseif entity.Name == "SeekMoving" or entity.Name == "SeekRig" then
            local room, _ = GetCurrentRoom()
            if room then
                local door = room:FindFirstChild("Door")
                if door and door:FindFirstChildWhichIsA("BasePart") then
                    SmoothMoveTo(door.Position, 5, 2)
                end
            end
        end
        return
    end

    -- 3. Oda ve Kapı Otomasyonu
    local room, roomNum = GetCurrentRoom()
    if not room then return end

    if roomNum ~= _G.GameState.LastRoomNumber then
        _G.GameState.LastRoomNumber = roomNum
        _G.Statistics.RoomsCompleted = roomNum
        _G.GameState.IsHiding = false
    end

    -- Kütüphane Odası Kontrolü
    if room.Name == "50" then
        SolveLibrary(room)
        return
    end

    -- Anahtar Toplama
    if _G.Settings.AutoPickupKeys then
        for _, obj in pairs(room:GetDescendants()) do
            if obj.Name:find("Key") then
                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                local part = obj:FindFirstChildWhichIsA("BasePart", true) or obj
                if prompt and part then
                    SmoothMoveTo(part.Position, 5, 2)
                    if prompt.TriggerPrompt then prompt:TriggerPrompt() else fireproximityprompt(prompt) end
                    _G.Statistics.KeysCollected = _G.Statistics.KeysCollected + 1
                end
            end
        end
    end

    -- Sonraki Kapıya Git ve Aç
    local nextDoor = FindNextDoor(room, HumanoidRootPart)
    if nextDoor then
        local doorPart = nextDoor:FindFirstChildWhichIsA("BasePart")
        if doorPart then
            SmoothMoveTo(doorPart.Position, 8, 2.5)
            
            local lock = nextDoor:FindFirstChild("Lock")
            if lock and HasKeyInInventory() then
                local lockPrompt = lock:FindFirstChildWhichIsA("ProximityPrompt", true)
                if lockPrompt then
                    if lockPrompt.TriggerPrompt then lockPrompt:TriggerPrompt() else fireproximityprompt(lockPrompt) end
                    task.wait(0.2)
                end
            end
            
            local doorPrompt = nextDoor:FindFirstChildWhichIsA("ProximityPrompt", true)
            if doorPrompt then
                if doorPrompt.TriggerPrompt then doorPrompt:TriggerPrompt() else fireproximityprompt(doorPrompt) end
                _G.Statistics.DoorsOpened = _G.Statistics.DoorsOpened + 1
                task.wait(0.3)
            end
        end
    end
end)

