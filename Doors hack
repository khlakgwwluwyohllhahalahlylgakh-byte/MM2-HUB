local flightConnection
local bodyVelocity
local bodyGyro
local particleEmitter

local function CreateFlightParticles(character)
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local attachment = Instance.new("Attachment")
    attachment.Parent = rootPart
    attachment.Position = Vector3.new(0, -2, 0)
    
    local particle = Instance.new("ParticleEmitter")
    particle.Parent = attachment
    particle.Texture = "rbxassetid://12805312561"
    particle.Rate = 50
    particle.Lifetime = NumberRange.new(0.3, 0.8)
    particle.Speed = NumberRange.new(1, 3)
    particle.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.2),
        NumberSequenceKeypoint.new(1, 0)
    })
    particle.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 0, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 0, 200))
    })
    particle.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1)
    })
    particle.SpreadAngle = Vector2.new(10, 10)
    particle.Enabled = _G.Settings.FlightParticles or false
    
    return particle
end

local function StartFlight()
    if flightConnection then
        flightConnection:Disconnect()
    end
    
    flightConnection = RunService.RenderStepped:Connect(function()
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoid = character:FindFirstChild("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not rootPart then return end
        
        humanoid.PlatformStand = true
        
        if not bodyVelocity or not bodyVelocity.Parent then
            bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyVelocity.Parent = rootPart
        end
        
        if not bodyGyro or not bodyGyro.Parent then
            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bodyGyro.CFrame = rootPart.CFrame
            bodyGyro.Parent = rootPart
        end
        
        if _G.Settings.FlightParticles then
            if not particleEmitter or not particleEmitter.Parent then
                particleEmitter = CreateFlightParticles(character)
            end
        else
            if particleEmitter then
                particleEmitter:Destroy()
                particleEmitter = nil
            end
        end
    end)
end

local function StopFlight()
    if flightConnection then
        flightConnection:Disconnect()
        flightConnection = nil
    end
    
    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end
    
    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end
    
    if particleEmitter then
        particleEmitter:Destroy()
        particleEmitter = nil
    end
    
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
        end
    end
end

-- Süzülerek hedefe gitme fonksiyonu
local function GlideToTarget(targetPosition, targetPart)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    local speed = _G.Settings.FlightSpeed or 30
    local smoothness = _G.Settings.GlideSmoothness or 8
    local targetDistance = _G.Settings.TargetDistance or 6
    
    local flightComplete = false
    local flightTime = 0
    local maxFlightTime = 5
    
    local glideConnection
    glideConnection = RunService.RenderStepped:Connect(function(deltaTime)
        flightTime = flightTime + deltaTime
        
        if flightTime > maxFlightTime or flightComplete then
            glideConnection:Disconnect()
            return
        end
        
        local currentPos = rootPart.Position
        local distance = (targetPosition - currentPos).Magnitude
        
        if distance <= targetDistance then
            flightComplete = true
            
            if targetPart then
                firetouchinterest(character, targetPart.Parent or targetPart, 0)
                task.wait(0.1)
                firetouchinterest(character, targetPart.Parent or targetPart, 1)
                
                local prompt = targetPart.Parent and targetPart.Parent:FindFirstChildWhichIsA("ProximityPrompt")
                if prompt then
                    fireproximityprompt(targetPart.Parent)
                end
            end
            
            glideConnection:Disconnect()
            return
        end
        
        local direction = (targetPosition - currentPos).unit
        local smoothFactor = math.min(1, distance / smoothness)
        local currentSpeed = speed * smoothFactor
        local waveEffect = math.sin(flightTime * 3) * 2 * smoothFactor
        local targetHeight = targetPosition.Y + 2 + waveEffect
        
        local newPosition = currentPos + direction * currentSpeed * deltaTime
        newPosition = Vector3.new(
            newPosition.X,
            currentPos.Y + (targetHeight - currentPos.Y) * deltaTime * 3,
            newPosition.Z
        )
        
        if bodyVelocity then
            bodyVelocity.Velocity = (newPosition - currentPos) / deltaTime
        end
        
        if bodyGyro then
            local lookAt = CFrame.lookAt(currentPos, targetPosition)
            bodyGyro.CFrame = lookAt
        end
        
        rootPart.CFrame = CFrame.lookAt(currentPos, Vector3.new(targetPosition.X, currentPos.Y, targetPosition.Z))
    end)
    
    return true
end

-- Anahtar arama ve toplama sistemi
local function FindAndCollectKey()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local nearestKey = nil
    local nearestDistance = 200
    
    for _, item in pairs(Workspace:GetDescendants()) do
        if item:IsA("Tool") or item:IsA("Model") then
            local name = item.Name:lower()
            if name:find("key") and not name:find("keyhole") and not name:find("keycardreader") then
                local handle = item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart")
                if handle then
                    local distance = (rootPart.Position - handle.Position).Magnitude
                    if distance < nearestDistance then
                        nearestDistance = distance
                        nearestKey = {item = item, part = handle, position = handle.Position}
                    end
                end
            end
        end
    end
    
    return nearestKey
end

-- Anahtarlı kapı bulma ve açma
local function FindAndOpenLockedDoor(hasKey)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    local nearestLockedDoor = nil
    local nearestDistance = 100
    
    for _, door in pairs(Workspace:GetDescendants()) do
        if door:IsA("Model") then
            local name = door.Name:lower()
            if name:find("door") and (name:find("lock") or name:find("key")) then
                local doorPart = door:FindFirstChild("Door") or door:FindFirstChildWhichIsA("BasePart")
                if doorPart then
                    local lock = door:FindFirstChild("Lock") or door:FindFirstChildWhichIsA("ProximityPrompt")
                    if lock then
                        local distance = (rootPart.Position - doorPart.Position).Magnitude
                        if distance < nearestDistance then
                            nearestDistance = distance
                            nearestLockedDoor = {door = door, part = doorPart, lock = lock, position = doorPart.Position}
                        end
                    end
                end
            end
        end
    end
    
    if nearestLockedDoor and hasKey then
        GlideToTarget(nearestLockedDoor.position, nearestLockedDoor.lock or nearestLockedDoor.part)
        
        task.wait(0.5)
        if nearestLockedDoor.lock then
            fireproximityprompt(nearestLockedDoor.door)
        end
        
        fireclickdetector(nearestLockedDoor.door)
        return true
    end
    
    return false
end

