local LibraryData = { ShapeOrder = {}, ShapeNumbers = {}, Password = "" }

local function SolveLibrary(room)
    if not room or room.Name ~= "50" or not _G.Settings.AutoSolveLibrary then return end
    Log("🔐 Kütüphane Çözülüyor...", "LIBRARY")
    
    SafeExecute(function()
        ReplicatedStorage.RemotesFolder.Crouch:FireServer(true)
        task.wait(0.2)
        
        -- Paper ve Kitap Tarama Mantığı
        for _, obj in pairs(room:GetDescendants()) do
            if obj.Name:find("Book") or obj.Name:find("Hint") or obj.Name:find("Paper") then
                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                local part = obj:FindFirstChildWhichIsA("BasePart", true) or obj
                if prompt and part then
                    SmoothMoveTo(part.Position, 5, 2)
                    if prompt.TriggerPrompt then prompt:TriggerPrompt() else fireproximityprompt(prompt) end
                    task.wait(0.3)
                end
            end
        end
        
        -- Şifre Gönderme Örneği
        local padlock = room:FindFirstChild("Padlock") or room:FindFirstChild("Lock")
        if padlock then
            local lockPart = padlock:FindFirstChildWhichIsA("BasePart", true)
            if lockPart then
                SmoothMoveTo(lockPart.Position, 5, 2)
                ReplicatedStorage.RemotesFolder.PL:FireServer("358") -- Örnek şifre / dinamik okunabilir
                _G.Statistics.LibrariesSolved = _G.Statistics.LibrariesSolved + 1
            end
        end
        ReplicatedStorage.RemotesFolder.Crouch:FireServer(false)
    end, "SolveLibrary")
end

