RunService.RenderStepped:Connect(function()
    pcall(function()
        -- 1. Godmode
        if _G.Settings.Godmode and Humanoid then
            Humanoid.Health = Humanoid.MaxHealth
        end

        if not _G.Settings.AIEnabled then return end

        -- 2. Tehdit Algılama
        for _, entity in ipairs(Workspace:GetChildren()) do
            if (_G.Settings.RushDetection and entity.Name == "RushMoving") or (_G.Settings.AmbushDetection and entity.Name == "AmbushMoving") then
                local closet = Workspace:FindFirstChild("Wardrobe", true) or Workspace:FindFirstChild("Closet", true)
                if closet then SmoothMoveTo(closet.Position, 2) end
            end
        end

        -- 3. Kapı & Oda Otomasyonu
        local room, roomNum = GetCurrentRoom()
        if room then
            if room.Name == "50" then SolveLibrary(room) end
            
            local door = room:FindFirstChild("Door", true)
            if door and door:FindFirstChild("Door") then
                local target = door:FindFirstChild("Door").Position
                if Distance(HumanoidRootPart.Position, target) > 5 then
                    SmoothMoveTo(target)
                end
            end
        end
    end)
end)

