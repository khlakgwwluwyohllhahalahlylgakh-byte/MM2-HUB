-- DÖNGÜ VE YAPAY ZEKA ANA MANTIĞI
-- ==========================================================
task.spawn(function()
    local isHiding = false
    local lastRoomNum = -1
    
    while task.wait(0.1) do
        if not _G.DoorsAI_Running then break end
        
        if _G.Settings.AIBot then
            pcall(function()
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChild("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hum or not hrp then return end

                local room = GetCurrentRoom()
                if not room then return end

                -- Oda değişimini kontrol et
                local currentRoomNum = tonumber(room.Name) or -1
                if currentRoomNum ~= lastRoomNum then
                    lastRoomNum = currentRoomNum
                    if currentRoomNum > 0 then
                        _G.BotStats.RoomsCleared = currentRoomNum
                        Log("Oda " .. currentRoomNum .. " açıldı")
                    end
                end

                -- [DURUM 1]: SEEK KOVALAMACASI (Eksiksiz Hızlı Kaçış)
                if IsSeekActive() then
                    Log("⚠️ SEEK KOVALAMASI! Kaçış başladı")
                    hum.WalkSpeed = 23
                    local door = room:FindFirstChild("Door")
                    if door then
                        local doorPart = door:FindFirstChild("Door") or door:FindFirstChildWhichIsA("BasePart")
                        if doorPart then
                            hum:MoveTo(doorPart.Position)
                        end
                    end
                    _G.BotStats.EntitiesAvoided = _G.BotStats.EntitiesAvoided + 1
                    return
                else
                    hum.WalkSpeed = _G.Settings.SafeWalkSpeed
                end

                -- [DURUM 2]: AMBUSH / RUSH KORUMASI
                local entity = GetActiveEntity()
                if entity then
                    Log("⚠️ " .. entity.Name .. " ALGILANDI! Saklanma başlıyor")
                    _G.CancelWalk = true
                    _G.BotStats.EntitiesAvoided = _G.BotStats.EntitiesAvoided + 1
                    
                    if not isHiding then
                        local bestCloset = FindClosetInRoom(room, hrp)
                        
                        if bestCloset then
                            local part = bestCloset:FindFirstChildWhichIsA("BasePart", true)
                            local prompt = bestCloset:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if part and prompt then
                                SmartWalk(part.Position, 3)
                                task.wait(0.1)
                                fireproximityprompt(prompt)
                                isHiding = true
                                Log("Dolapın içinde saklandı")
                            end
                        end
                    end

                    WaitForEntityTimeout(30)
                    
                    if isHiding then
                        task.wait(1.2)
                        hum:MoveTo(hrp.Position + hrp.CFrame.LookVector * 4)
                        isHiding = false
                        Log("Dolaptan çıkıldı")
                    end
                    return
                end

                -- [DURUM 3]: ODA 50 (KÜTÜPHANE VE FİGÜR) - ŞİFRE ÇÖZME SİSTEMİ
                if room.Name == "50" then
                    Log("📚 Kütüphane (Oda 50) başladı")
                    _G.BotStats.LibrarySolved = _G.BotStats.LibrarySolved + 1
                    LibraryStatusLabel:Set("⏳ Şifre çözülüyor...")
                    
                    -- Figür'den gizlenmek için otomatik eğil
                    pcall(function()
                        ReplicatedStorage.RemotesFolder.Crouch:FireServer(true)
                        Log("Eğilme başladı")
                    end)

                    -- ADIM 1: Kağıdı Al (Şekil sırasını oku)
                    Log("ADIM 1: Kağıt aranıyor...")
                    local paper, paperPrompt = FindPaperInRoom(room)
                    if paper and paperPrompt then
                        SmartWalk(paper.Position, 3)
                        task.wait(0.2)
                        fireproximityprompt(paperPrompt)
                        Log("Kağıt alındı")
                        task.wait(0.5)
                        
                        -- Kalpte görünen şekil sırasını oku
                        ReadShapeOrderFromHeart()
                        task.wait(0.3)
                    end

                    -- ADIM 2: Kitapları Topla ve Şekil-Sayı Eşleşmesini Çıkar
                    Log("ADIM 2: Kitaplar toplandı ve analiz ediliyor...")
                    ExtractShapeNumbersFromBooks(room)
                    task.wait(0.5)

                    -- ADIM 3: Şifre Çöz
                    Log("ADIM 3: Şifre çözülüyor...")
                    local solvedPassword = SolvePassword()
                    task.wait(0.3)

                    -- ADIM 4: Kilitli Kapıya Yürü ve Şifreyi Gönder
                    if solvedPassword ~= "" then
                        Log("ADIM 4: Şifre gönderiliyor: " .. solvedPassword)
                        local padLock = room:FindFirstChild("Padlock", true)
                        if padLock then
                            SmartWalk(padLock.Position, 3)
                            task.wait(0.5)
                            pcall(function()
                                ReplicatedStorage.RemotesFolder.PL:FireServer(solvedPassword)
                                Log("✅ Şifre başarıyla gönderildi!")
                                Rayfield:Notify({
                                    Title = "Şifre Çözüldü!",
                                    Content = "Şifre: " .. solvedPassword,
                                    Duration = 3
                                })
                            end)
                        end
                    else
                        Log("❌ Şifre çözilemedi, manual giriş gerekli")
                        Rayfield:Notify({
                            Title = "Uyarı",
                            Content = "Şifre otomatik çözilemedi. Manuel olarak kontrol et.",
                            Duration = 3
                        })
                    end
                    
                    -- Eğilmeyi kapat
                    pcall(function()
                        ReplicatedStorage.RemotesFolder.Crouch:FireServer(false)
                    end)
                    return
                end

                -- [DURUM 4]: NORMAL ODA İLERLEMESİ, ANAHTAR VE KAPI
                local door = room:FindFirstChild("Door")
                if door then
                    local lock = door:FindFirstChild("Lock")
                    local hasKey = char:FindFirstChild("Key") or LocalPlayer.Backpack:FindFirstChild("Key")

                    if lock and not hasKey then
                        Log("🔑 Anahtar aranıyor...")
                        local key, keyPrompt = FindKeyInRoom(room)
                        if key and keyPrompt then
                            local keyPart = key:FindFirstChildWhichIsA("BasePart", true)
                            if keyPart then
                                SmartWalk(keyPart.Position, 3)
                                task.wait(0.2)
                                fireproximityprompt(keyPrompt)
                                Log("Anahtar alındı")
                                task.wait(0.5)
                            end
                        end
                    else
                        Log("🚪 Kapı açılıyor...")
                        local doorPart = door:FindFirstChild("Door") or door:FindFirstChildWhichIsA("BasePart")
                        if doorPart then
                            SmartWalk(doorPart.Position, 3)
                            task.wait(0.2)
                            
                            if lock and hasKey then
                                local keyTool = LocalPlayer.Backpack:FindFirstChild("Key")
                                if keyTool then 
                                    hum:EquipTool(keyTool)
                                    task.wait(0.1)
                                end
                                
                                local lockPrompt = lock:FindFirstChildWhichIsA("ProximityPrompt", true)
                                if lockPrompt then 
                                    fireproximityprompt(lockPrompt)
                                    Log("Kilit açıldı")
                                    task.wait(0.3) 
                                end
                            end
                            
                            local doorPrompt = doorPart.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if doorPrompt then 
                                fireproximityprompt(doorPrompt)
                                Log("Kapı açıldı")
                            end
                            
                            firetouchinterest(hrp, doorPart, 0)
                            task.wait(0.05)
                            firetouchinterest(hrp, doorPart, 1)
                        end
                    end
                end
            end)
        else
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = 16
            end
        end
    end
end)

