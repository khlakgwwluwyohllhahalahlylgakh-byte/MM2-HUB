-- LOGGING SYSTEM
-- ==========================================================
local function Log(message, level)
    level = level or "INFO"
    if _G.Settings.DebugMode or _G.Settings.VerboseLogging then
        print(string.format("[%s] [%s] %s", os.date("%H:%M:%S"), level, message))
    end
end

local function Error(message)
    _G.Statistics.Errors = _G.Statistics.Errors + 1
    Log("[ERROR] " .. message, "ERROR")
end

local function Success(message)
    Log("[SUCCESS] " .. message, "SUCCESS")
end

local function SafeExecute(func, errorName)
    local success, result = pcall(func)
    if not success then
        Error("[" .. (errorName or "Unknown") .. "] " .. tostring(result))
        return nil
    end
    return result
end

-- ==========================================================
-- UTILITY & ROOM GETTERS
-- ==========================================================
local function GetCurrentRoom()
    local gameData = ReplicatedStorage:FindFirstChild("GameData")
    if gameData and gameData:FindFirstChild("LatestRoom") then
        local roomNum = gameData.LatestRoom.Value
        _G.GameState.CurrentRoomNumber = roomNum
        local rooms = Workspace:FindFirstChild("Rooms")
        if rooms then
            local room = rooms:FindFirstChild(tostring(roomNum))
            return room, roomNum
        end
    end
    return nil, 0
end

local function Distance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

local function HasKeyInInventory()
    if not Character then return false end
    return Character:FindFirstChild("Key") ~= nil or LocalPlayer.Backpack:FindFirstChild("Key") ~= nil
end

-- ==========================================================
-- 🚀 120 FPS AKICI & OPTİMAL HAREKET MOTORU (NATURAL PLAYER)
-- ==========================================================
local function SmoothMoveTo(targetPos, timeout, stoppingDistance)
    timeout = timeout or 10
    stoppingDistance = stoppingDistance or 2.5
    
    if not Character or not HumanoidRootPart then return false end
    
    local startTime = tick()
    while Distance(HumanoidRootPart.Position, targetPos) > stoppingDistance do
        if not _G.Settings.AIEnabled or tick() - startTime > timeout or not Character or not HumanoidRootPart then
            return false
        end
        
        local currentPos = HumanoidRootPart.Position
        local direction = (targetPos - currentPos).Unit
        local step = direction * math.min(_G.Settings.SmoothSpeed * RunService.RenderStepped:Wait(), Distance(currentPos, targetPos))
        
        HumanoidRootPart.CFrame = CFrame.new(currentPos + step, targetPos + Vector3.new(0, 1, 0))
        RunService.RenderStepped:Wait()
    end
    return true
end

-- ==========================================================
-- 🔍 FAKE DOOR DETECTION SYSTEM
-- ==========================================================
local function AnalyzeDoor(doorPart, doorModel)
    if not doorPart or not doorModel then return false end
    local confidence = 0
    
    for _, part in pairs(doorModel:GetDescendants()) do
        if part:IsA("BasePart") and (part.Material == Enum.Material.Brick or part.Material == Enum.Material.Concrete) then
            confidence = confidence + 0.35
        end
    end
    
    if doorPart.Size.X < 3.5 or doorPart.Size.Y < 5.5 then
        confidence = confidence + 0.4
    end
    
    local hasPrompt = false
    for _, obj in pairs(doorModel:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            hasPrompt = true
            break
        end
    end
    if not hasPrompt then confidence = confidence + 0.4 end
    
    return confidence >= 0.6
end

local function FindNextDoor(room, hrp)
    if not room or not hrp then return nil end
    local bestDoor, shortestDist = nil, math.huge
    
    SafeExecute(function()
        local doors = room:FindFirstChild("Doors") or room
        for _, doorModel in pairs(doors:GetChildren()) do
            if doorModel.Name == "Door" then
                local doorPart = doorModel:FindFirstChildWhichIsA("BasePart")
                if doorPart then
                    local dist = Distance(hrp.Position, doorPart.Position)
                    if _G.Settings.FakeDoorDetection and AnalyzeDoor(doorPart, doorModel) then
                        goto skip_door
                    end
                    if dist < shortestDist then
                        shortestDist = dist
                        bestDoor = doorModel
                    end
                    ::skip_door::
                end
            end
        end
    end, "FindNextDoor")
    
    return bestDoor
end

-- ==========================================================
-- 👹 ENTITY & HIDING MANAGEMENT
-- ==========================================================
local function DetectThreat()
    for _, entity in ipairs(Workspace:GetChildren()) do
        local name = entity.Name
        if (_G.Settings.SeekDetection and (name == "SeekMoving" or name == "SeekRig")) or
           (_G.Settings.RushDetection and name == "RushMoving") or
           (_G.Settings.AmbushDetection and name == "AmbushMoving") or
           (_G.Settings.EyesDetection and name == "Eyes") then
            return true, entity
        end
    end
    return false, nil
end

local function FindNearestCloset()
    local closest, shortest = nil, math.huge
    for _, room in ipairs(Workspace:FindFirstChild("Rooms") and Workspace.Rooms:GetChildren() or {}) do
        for _, obj in ipairs(room:GetDescendants()) do
            if obj.Name == "Wardrobe" or obj.Name == "Closet" or obj.Name == "Locker" then
                local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    local dist = Distance(HumanoidRootPart.Position, part.Position)
                    if dist < shortest then
                        shortest = dist
                        closest = obj
                    end
                end
            end
        end
    end
    return closest
end

local function HideInCloset()
    if not _G.Settings.AutoHideInClosets then return end
    local closet = FindNearestCloset()
    if closet then
        local part = closet.PrimaryPart or closet:FindFirstChildWhichIsA("BasePart", true)
        local prompt = closet:FindFirstChildWhichIsA("ProximityPrompt", true)
        if part and prompt then
            SmoothMoveTo(part.Position, 8, 2)
            task.wait(0.1)
            if prompt.TriggerPrompt then prompt:TriggerPrompt() else fireproximityprompt(prompt) end
            _G.GameState.IsHiding = true
            _G.Statistics.TimesHidden = _G.Statistics.TimesHidden + 1
        end
    end
end

