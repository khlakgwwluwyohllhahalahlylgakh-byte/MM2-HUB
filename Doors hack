        SliderDot.Parent = SliderBar
        SliderDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        SliderDot.Size = UDim2.new(0, 22, 0, 22) -- 📱 Daha büyük dot
        SliderDot.Position = UDim2.new((_G.Settings[setting] - min) / (max - min) - 0.04, 0, -0.9, 0)
        SliderDot.BorderSizePixel = 0
        SliderDot.Text = ""
        SliderDot.AutoButtonColor = false
        
        local SliderDotCorner = Instance.new("UICorner")
        SliderDotCorner.CornerRadius = UDim.new(1, 0)
        SliderDotCorner.Parent = SliderDot
        
        -- 📱 Dokunmatik slider güncelleme
        local function UpdateSlider(touchPos)
            local barSize = SliderBar.AbsoluteSize.X
            local relativePos = math.clamp((touchPos.X - SliderBar.AbsolutePosition.X) / barSize, 0, 1)
            local value = math.floor(min + (max - min) * relativePos)
            
            _G.Settings[setting] = value
            SliderLabel.Text = text .. ": " .. tostring(value)
            SliderFill.Size = UDim2.new(relativePos, 0, 1, 0)
            SliderDot.Position = UDim2.new(relativePos - 0.04, 0, -0.9, 0)
            
            if callback then callback(value) end
        end
        
        -- 📱 Touch events
        SliderBar.TouchTap:Connect(function(input)
            UpdateSlider(input.Position)
        end)
        
        SliderDot.TouchPan:Connect(function(input)
            UpdateSlider(input.Position)
        end)
        
        -- PC mouse desteği
        if isPC then
            SliderBar.MouseButton1Down:Connect(function()
                UpdateSlider({Position = Vector2.new(mouse.X, mouse.Y), X = mouse.X})
            end)
            
            SliderDot.MouseButton1Down:Connect(function()
                local connection
                connection = RunService.RenderStepped:Connect(function()
                    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                        connection:Disconnect()
                        return
                    end
                    UpdateSlider({Position = Vector2.new(mouse.X, mouse.Y), X = mouse.X})
                end)
            end)
        end
    end
    
