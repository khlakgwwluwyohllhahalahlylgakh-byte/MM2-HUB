local function GetEntityPosition(entity)
    if not entity then return nil end
    
    local pos = nil
    SafeExecute(function()
        if entity:FindFirstChild("HumanoidRootPart") then
            pos = entity.HumanoidRootPart.Position
        elseif entity:FindFirstChild("Torso") then
            pos = entity.Torso.Position
        elseif entity:FindFirstChild("Head") then
            pos = entity.Head.Position
        else
            for _, part in pairs(entity:GetChildren()) do
                if part:IsA("BasePart") then
                    pos = part.Position
                    break
                end
            end
        end
    end, "GetEntityPosition")
    
    return pos
end

local function IsEntityThreatening()
    local hrp = GetHumanoidRootPart()
    if not hrp then return false end
    
    local threatDistance = {
        Seek = 80,
        Rush = 60,
        Ambush = 50
    }
    
    for _, entity in pairs(Workspace:GetChildren()) do
        if entity.Name == "SeekMoving" or entity.Name == "SeekRig" then
            local pos = GetEntityPosition(entity)
            if pos and Distance(hrp.Position, pos) < threatDistance.Seek then
                _G.GameState.ActiveEntity = entity
                _G.GameState.EntityType = "Seek"
                return true
            end
        elseif entity.Name == "RushMoving" then
            local pos = GetEntityPosition(entity)
            if pos and Distance(hrp.Position, pos) < threatDistance.Rush then
                _G.GameState.ActiveEntity = entity
                _G.GameState.EntityType = "Rush"
                return true
            end
        elseif entity.Name == "AmbushMoving" then
            local pos = GetEntityPosition(entity)
            if pos and Distance(hrp.Position, pos) < threatDistance.Ambush then
                _G.GameState.ActiveEntity = entity
                _G.GameState.EntityType = "Ambush"
                return true
            end
        end
    end
    
    _G.GameState.ActiveEntity = nil
    _G.GameState.EntityType = nil
    return false
end

