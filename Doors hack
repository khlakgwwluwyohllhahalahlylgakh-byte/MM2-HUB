local flightConn, bodyVel, bodyGyro, particleEmi

local function CreateFlightParticles(char)
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local att = Instance.new("Attachment")
    att.Parent = root
    att.Position = Vector3.new(0, -2, 0)
    
    local part = Instance.new("ParticleEmitter")
    part.Parent = att
    part.Texture = "rbxassetid://12805312561"
    part.Rate = 35
    part.Lifetime = NumberRange.new(0.3, 0.6)
    part.Speed = NumberRange.new(1, 2)
    part.Size = NumberSequence.new(0.15, 0)
    part.Color = ColorSequence.new(Color3.fromRGB(120, 80, 255))
    return part
end

local function StartFlight()
    if flightConn then flightConn:Disconnect() end
    flightConn = RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end
        
        hum.PlatformStand = true
        
        if not bodyVel or not bodyVel.Parent then
            bodyVel = Instance.new("BodyVelocity")
            bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bodyVel.Velocity = Vector3.new(0, 0, 0)
            bodyVel.Parent = root
        end
        
        if not bodyGyro or not bodyGyro.Parent then
            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bodyGyro.CFrame = root.CFrame
            bodyGyro.Parent = root
        end
        
        if _G.Settings.FlightParticles then
            if not particleEmi or not particleEmi.Parent then
                particleEmi = CreateFlightParticles(char)
            end
        else
            if particleEmi then particleEmi:Destroy(); particleEmi = nil end
        end
    end)
end

local function StopFlight()
    if flightConn then flightConn:Disconnect(); flightConn = nil end
    if bodyVel then bodyVel:Destroy(); bodyVel = nil end
    if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end
    if particleEmi then particleEmi:Destroy(); particleEmi = nil end
    
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

-- Kayarak Hedefe Gitme Motoru
local function GlideToTarget(targetPos, targetPart)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local speed = _G.Settings.FlightSpeed or 35
    local smoothness = _G.Settings.GlideSmoothness or 8
    local targetDist = _G.Settings.TargetDistance or 6
    
    local completed = false
    local timeElapsed = 0
    
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        timeElapsed = timeElapsed + dt
        if timeElapsed > 6 or completed then
            conn:Disconnect()
            return
        end
        
        local currentPos = root.Position
        local dist = (targetPos - currentPos).Magnitude
        
        if dist <= targetDist then
            completed = true
            if targetPart then
                pcall(function()
                    firetouchinterest(char, targetPart.Parent or targetPart, 0)
                    task.wait(0.05)
                    firetouchinterest(char, targetPart.Parent or targetPart, 1)
                    local prompt = targetPart.Parent and targetPart.Parent:FindFirstChildWhichIsA("ProximityPrompt")
                    if prompt then fireproximityprompt(targetPart.Parent) end
                end)
            end
            conn:Disconnect()
            return
        end
        
        local dir = (targetPos - currentPos).unit
        local smoothFactor = math.min(1, dist / smoothness)
        local curSpeed = speed * smoothFactor
        local targetH = targetPos.Y + 2
        
        local newPos = currentPos + dir * curSpeed * dt
        newPos = Vector3.new(newPos.X, currentPos.Y + (targetH - currentPos.Y) * dt * 3, newPos.Z)
        
        if bodyVel then bodyVel.Velocity = (newPos - currentPos) / dt end
        if bodyGyro then bodyGyro.CFrame = CFrame.lookAt(currentPos, targetPos) end
    end)
end

-- Anahtar Arama Fonksiyonu
local function FindKey()
    local char = LocalPlayer.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local bestKey, bestDist = nil, 250
    for _, item in pairs(Workspace:GetDescendants()) do
        if item:IsA("Tool") or item:IsA("Model") then
            local name = item.Name:lower()
            if name:find("key") and not name:find("keyhole") then
                local handle = item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart")
                if handle then
                    local dist = (root.Position - handle.Position).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestKey = {item = item, part = handle, pos = handle.Position}
                    end
                end
            end
        end
    end
    return bestKey
end

-- Otomasyon Ana Döngüsü
task.spawn(function()
    local hiding = false
    local lastHideTime = 0
    local hasKey = false
    local keyTimer = 0
    
    while true do
        task.wait(0.1)
        if not _G.DoorsMasterHubRunning then break end
        
        if _G.Settings.FlightMode then
            if not flightConn then StartFlight() end
        else
            if flightConn then StopFlight() end
        end
        
        if _G.Settings.AutoPlayMaster then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                if _G.RefreshMap then
                    _G.RefreshMap = false
                    hiding = false
                    hasKey = false
                end
                
                keyTimer = keyTimer + 0.1
                if keyTimer >= 2 then
                    keyTimer = 0
                    hasKey = false
                    if char then
                        for _, child in pairs(char:GetChildren()) do
                            if child:IsA("Tool") and child.Name:lower():find("key") then
                                hasKey = true
                                break
                            end
                        end
                    end
                end
                
                -- Canavar / Tehlike Tespiti
                local dangerDetected = nil
                local minDangerDist = 140
                for _, v in pairs(Workspace:GetChildren()) do
                    if v:IsA("Model") or v:IsA("Part") then
                        local name = v.Name
                        if name:find("Rush") or name:find("Ambush") or name:find("Figure") or name:find("Screech") then
                            local part = v:FindFirstChild("Root") or v:FindFirstChild("Base") or v:FindFirstChildWhichIsA("BasePart")
                            if part then
                                local dist = (hrp.Position - part.Position).Magnitude
                                if dist < minDangerDist then
                                    minDangerDist = dist
                                    dangerDetected = v
                                end
                            end
                        end
                    end
                end
                
                if dangerDetected and _G.Settings.EntityAvoid then
                    if not hiding then
                        hiding = true
                        lastHideTime = tick()
                        local bestCloset, bestDist = nil, 70
                        for _, room in pairs(Workspace:GetDescendants()) do
                            if room:IsA("Model") then
                                for _, obj in pairs(room:GetDescendants()) do
                                    local oName = obj.Name:lower()
                                    if oName:find("wardrobe") or oName:find("closet") or oName:find("hiding") then
                                        local doorP = obj:FindFirstChild("Door") or obj:FindFirstChild("Entrance") or obj:FindFirstChildWhichIsA("BasePart")
                                        if doorP then
                                            local d = (hrp.Position - doorP.Position).Magnitude
                                            if d < bestDist then
                                                bestDist = d
                                                bestCloset = doorP
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        if bestCloset then
                            if _G.Settings.FlightMode then
                                GlideToTarget(bestCloset.Position, bestCloset)
                            else
                                hrp.CFrame = bestCloset.CFrame * CFrame.new(0, 0, -2)
                            end
                            pcall(function() fireproximityprompt(bestCloset.Parent) end)
                        end
                    end
                else
                    if hiding and (tick() - lastHideTime) > 2.5 then
                        hiding = false
                        hrp.CFrame = hrp.CFrame + hrp.CFrame.LookVector * 6
                        task.wait(0.3)
                    end
                    
                    if _G.Settings.AutoKeyCollect and not hiding then
                        local kData = FindKey()
                        if kData then
                            if _G.Settings.FlightMode then
                                GlideToTarget(kData.pos, kData.part)
                            else
                                hrp.CFrame = kData.part.CFrame
                            end
                            pcall(function()
                                fireproximityprompt(kData.item)
                                firetouchinterest(char, kData.item, 0)
                                firetouchinterest(char, kData.item, 1)
                            end)
                            hasKey = true
                        end
                    end
                    
                    if not hiding and not hasKey then
                        local nearestDoor, nearestDist = nil, 90
                        for _, door in pairs(Workspace:GetDescendants()) do
                            if door.Name == "Door" or door.Name == "DoorWood" or door.Name == "Gate" then
                                local knob = door:FindFirstChild("Knob") or door:FindFirstChild("Handle")
                                local part = door:FindFirstChild("Door") or door:FindFirstChildWhichIsA("BasePart")
                                local target = knob or part
                                if target and target:IsA("BasePart") then
                                    local dist = (hrp.Position - target.Position).Magnitude
                                    if dist < nearestDist then
                                        nearestDist = dist
                                        nearestDoor = {door = door, target = target}
                                    end
                                end
                            end
                        end
                        
                        if nearestDoor then
                            if _G.Settings.FlightMode then
                                GlideToTarget(nearestDoor.target.Position, nearestDoor.target)
                            else
                                local tPos = nearestDoor.target.Position
                                local moveDir = (tPos - hrp.Position).unit
                                hrp.CFrame = CFrame.new(tPos - moveDir * 3)
                            end
                            task.wait(0.2)
                            pcall(function()
                                fireclickdetector(nearestDoor.door)
                                fireproximityprompt(nearestDoor.door)
                            end)
                        end
                    end
                end
            end)
        end
    end
end)

