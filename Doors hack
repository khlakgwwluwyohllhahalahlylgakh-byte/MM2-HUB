task.spawn(function()
    local currentlyHiding = false
    local lastHidingCheck = 0
    local HIDING_COOLDOWN = 2
    local hasKey = false
    local keyCheckTimer = 0
    
    while true do
        task.wait(0.1)
        
        if _G.Settings and _G.Settings.FlightMode then
            if not flightConnection then
                StartFlight()
            end
        else
            if flightConnection then
                StopFlight()
            end
        end
        
        if _G.Settings and _G.Settings.AutoPlayMaster then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                if _G.RefreshMap then
                    _G.RefreshMap = false
                    currentlyHiding = false
                    hasKey = false
                end
                
                keyCheckTimer = keyCheckTimer + 0.1
                if keyCheckTimer >= 2 then
                    keyCheckTimer = 0
                    hasKey = false
                    if char then
                        for _, child in pairs(char:GetChildren()) do
                            if child:IsA("Tool") and child.Name:lower():find("key") then
                                hasKey = true
                                break
                            end
                        end
                    end
                end
                
                -- Yaratık tespiti
                local detectedDanger = nil
                local closestDistance = 150
                
                for _, v in pairs(Workspace:GetChildren()) do
                    if v:IsA("Model") or v:IsA("Part") then
                        local name = v.Name
                        if name:find("Rush") or name:find("Ambush") or name:find("Figure") or name:find("Screech") then
                            local vPart = v:FindFirstChild("Root") or v:FindFirstChild("Base") or v:FindFirstChildWhichIsA("BasePart")
                            if vPart then
                                local distance = (hrp.Position - vPart.Position).Magnitude
                                if distance < closestDistance then
                                    closestDistance = distance
                                    detectedDanger = v
                                end
                            end
                        end
                    end
                end
                
                if detectedDanger and _G.Settings.EntityAvoid then
                    if not currentlyHiding then
                        currentlyHiding = true
                        lastHidingCheck = tick()
                        
                        local bestCloset = nil
                        local bestDistance = 60
                        
                        for _, room in pairs(Workspace:GetDescendants()) do
                            if room:IsA("Model") then
                                for _, obj in pairs(room:GetDescendants()) do
                                    local objName = obj.Name:lower()
                                    if objName:find("wardrobe") or objName:find("closet") or objName:find("hiding") then
                                        local doorPart = obj:FindFirstChild("Door") or obj:FindFirstChild("Entrance") or obj:FindFirstChildWhichIsA("BasePart")
                                        if doorPart then
                                            local dist = (hrp.Position - doorPart.Position).Magnitude
                                            if dist < bestDistance then
                                                bestDistance = dist
                                                bestCloset = doorPart
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        
                        if bestCloset then
                            if _G.Settings.FlightMode then
                                GlideToTarget(bestCloset.Position, bestCloset)
                            else
                                hrp.CFrame = bestCloset.CFrame * CFrame.new(0, 0, -2)
                            end
                            fireproximityprompt(bestCloset.Parent)
                        end
                    end
                else
                    if currentlyHiding and (tick() - lastHidingCheck) > HIDING_COOLDOWN then
                        currentlyHiding = false
                        hrp.CFrame = hrp.CFrame + hrp.CFrame.LookVector * 5
                        task.wait(0.3)
                    end
                    
                    -- Anahtar toplama
                    if _G.Settings.AutoKeyCollect and not currentlyHiding then
                        local keyData = FindAndCollectKey()
                        if keyData then
                            if _G.Settings.FlightMode then
                                GlideToTarget(keyData.position, keyData.part)
                            else
                                hrp.CFrame = keyData.part.CFrame
                            end
                            fireproximityprompt(keyData.item)
                            firetouchinterest(char, keyData.item, 0)
                            task.wait(0.2)
                            firetouchinterest(char, keyData.item, 1)
                            hasKey = true
                        end
                    end
                    
                    -- Anahtarlı kapı
                    if _G.Settings.AutoKeyDoor and hasKey and not currentlyHiding then
                        local doorOpened = FindAndOpenLockedDoor(hasKey)
                        if doorOpened then
                            hasKey = false
                            task.wait(1)
                        end
                    end
                    
                    -- Normal kapı
                    if not currentlyHiding and not hasKey then
                        local nearestDoor = nil
                        local nearestDoorDistance = 80
                        
                        for _, door in pairs(Workspace:GetDescendants()) do
                            if door.Name == "Door" or door.Name == "DoorWood" or door.Name == "Gate" then
                                local knob = door:FindFirstChild("Knob") or door:FindFirstChild("Handle")
                                local doorPart = door:FindFirstChild("Door") or door:FindFirstChildWhichIsA("BasePart")
                                local target = knob or doorPart
                                
                                if target and target:IsA("BasePart") then
                                    local dist = (hrp.Position - target.Position).Magnitude
                                    if dist < nearestDoorDistance then
                                        nearestDoorDistance = dist
                                        nearestDoor = {door = door, target = target}
                                    end
                                end
                            end
                        end
                        
                        if nearestDoor then
                            if _G.Settings.FlightMode then
                                GlideToTarget(nearestDoor.target.Position, nearestDoor.target)
                            else
                                local targetPos = nearestDoor.target.Position
                                local moveDirection = (targetPos - hrp.Position).unit
                                hrp.CFrame = CFrame.new(targetPos - moveDirection * 3)
                            end
                            
                            task.wait(0.2)
                            local doorModel = nearestDoor.door
                            if doorModel:IsA("Model") then
                                fireclickdetector(doorModel)
                                fireproximityprompt(doorModel)
                            end
                        end
                    end
                    
                    -- Altın toplama
                    if _G.Settings.AutoGold and not currentlyHiding then
                        for _, item in pairs(Workspace:GetDescendants()) do
                            if item:IsA("Tool") or item:IsA("Model") then
                                if item.Name:lower():find("gold") or item.Name:lower():find("coin") then
                                    local hitbox = item:FindFirstChild("Hitbox") or item:FindFirstChild("Handle") or item:FindFirstChildWhichIsA("BasePart")
                                    if hitbox and (hrp.Position - hitbox.Position).Magnitude < 50 then
                                        if _G.Settings.FlightMode then
                                            GlideToTarget(hitbox.Position, hitbox)
                                        else
                                            hrp.CFrame = hitbox.CFrame
                                        end
                                        fireproximityprompt(item)
                                        firetouchinterest(char, item, 0)
                                        firetouchinterest(char, item, 1)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

