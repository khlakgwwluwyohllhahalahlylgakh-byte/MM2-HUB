-- FAKE DOOR DETECTION SYSTEM (KRİTİK!)
-- ==========================================================
local function AnalyzeDoor(doorPart, doorModel)
    if not doorPart or not doorModel then return false end
    
    local analysis = {
        IsFake = false,
        Confidence = 0,
        Reasons = {}
    }
    
    -- [1] Texture Check
    local canvasSize = 0
    for _, part in pairs(doorModel:GetDescendants()) do
        if part:IsA("BasePart") then
            local texture = part.Material
            if texture == Enum.Material.Brick or texture == Enum.Material.Concrete then
                canvasSize = canvasSize + 1
            end
        end
    end
    
    if canvasSize > 2 then
        analysis.Confidence = analysis.Confidence + 0.3
        table.insert(analysis.Reasons, "Şüpheli Doku")
    end
    
    -- [2] Size Check (Sahte kapılar genellikle daha küçük)
    local doorSize = doorPart.Size
    if doorSize.X < 4 or doorSize.Y < 6 then
        analysis.Confidence = analysis.Confidence + 0.4
        table.insert(analysis.Reasons, "Gerçekçi Olmayan Boyut")
    end
    
    -- [3] Position Check (Duvara batıyor mu?)
    local doorPos = doorPart.Position
    local ray = Ray.new(doorPos, Vector3.new(0, -10, 0))
    local hit, hitPos = Workspace:FindPartOnRay(ray, Character)
    
    if hit and hit.Parent == doorModel.Parent then
        analysis.Confidence = analysis.Confidence + 0.25
        table.insert(analysis.Reasons, "Duvarda Batılı")
    end
    
    -- [4] Sound Check (Kapı sesi var mı?)
    local hasSound = false
    for _, obj in pairs(doorModel:GetDescendants()) do
        if obj:IsA("Sound") then
            hasSound = true
            break
        end
    end
    
    if not hasSound then
        analysis.Confidence = analysis.Confidence + 0.2
        table.insert(analysis.Reasons, "Kapı Sesi Yok")
    end
    
    -- [5] Prompt Check
    local hasPrompt = false
    for _, obj in pairs(doorModel:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            hasPrompt = true
            if obj.HoldDuration > 0.5 then
                analysis.Confidence = analysis.Confidence + 0.15
                table.insert(analysis.Reasons, "Anormal Prompt Süresi")
            end
            break
        end
    end
    
    if not hasPrompt then
        analysis.Confidence = analysis.Confidence + 0.3
        table.insert(analysis.Reasons, "Prompt Bulunamadı")
    end
    
    analysis.IsFake = analysis.Confidence >= 0.6
    
    Log("Kapı Analizi [" .. doorModel.Name .. "] - Sahte: " .. tostring(analysis.IsFake) 
        .. " (" .. math.floor(analysis.Confidence * 100) .. "%) - Sebep: " .. table.concat(analysis.Reasons, ", "), "DETECTION")
    
    return analysis.IsFake, analysis.Confidence, analysis.Reasons
end

local function FindNextDoor(room, hrp)
    if not room or not hrp then return nil end
    
    local bestDoor = nil
    local shortestDistance = math.huge
    
    SafeExecute(function()
        local doors = room:FindFirstChild("Doors")
        if doors then
            for _, doorModel in pairs(doors:GetChildren()) do
                if doorModel.Name == "Door" then
                    local doorPart = doorModel:FindFirstChildWhichIsA("BasePart")
                    if doorPart then
                        local dist = Distance(hrp.Position, doorPart.Position)
                        
                        -- Sahte kapı algılaması
                        if _G.Settings.FakeDoorDetection then
                            local isFake = AnalyzeDoor(doorPart, doorModel)
                            if isFake then
                                Log("🚫 SAHTE KAPI SEÇİLMİYOR!", "WARNING")
                                goto skip_door
                            end
                        end
                        
                        if dist < shortestDistance then
                            shortestDistance = dist
                            bestDoor = doorModel
                        end
                        
                        ::skip_door::
                    end
                end
            end
        end
    end, "FindNextDoor")
    
    return bestDoor
end

