local function ReadShapeOrderFromHeart()
    local shapeOrder = {}
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, screen in pairs(playerGui:GetDescendants()) do
            if screen:IsA("ImageLabel") or screen:IsA("Frame") then
                local shapeName = screen.Name
                if shapeName:find("Circle") then table.insert(shapeOrder, "Circle")
                elseif shapeName:find("Square") then table.insert(shapeOrder, "Square")
                elseif shapeName:find("Triangle") then table.insert(shapeOrder, "Triangle")
                elseif shapeName:find("Star") then table.insert(shapeOrder, "Star")
                elseif shapeName:find("Diamond") then table.insert(shapeOrder, "Diamond")
                elseif shapeName:find("Cross") then table.insert(shapeOrder, "Cross")
                end
            end
        end
    end
    _G.LibrarySystem.ShapeOrder = shapeOrder
    return shapeOrder
end

local function ExtractShapeNumbersFromBooks(room)
    if not room then return {} end
    local bookShapes = {}
    local books = FindBooksInRoom(room)
    
    for _, book in pairs(books) do
        if _G.Settings.AIBot then
            local prompt = book:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                SmartWalk(book.Position, 3)
                task.wait(0.1)
                fireproximityprompt(prompt)
                task.wait(0.3)
                
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if playerGui then
                    for _, textElement in pairs(playerGui:GetDescendants()) do
                        if textElement:IsA("TextLabel") or textElement:IsA("TextBox") then
                            local text = textElement.Text:lower()
                            local number = text:match("%d+")
                            if number then
                                if text:find("circle") then bookShapes["Circle"] = tonumber(number)
                                elseif text:find("square") then bookShapes["Square"] = tonumber(number)
                                elseif text:find("triangle") then bookShapes["Triangle"] = tonumber(number)
                                elseif text:find("star") then bookShapes["Star"] = tonumber(number)
                                elseif text:find("diamond") then bookShapes["Diamond"] = tonumber(number)
                                elseif text:find("cross") then bookShapes["Cross"] = tonumber(number)
                                end
                            end
                        end
                    end
                end
                task.wait(0.2)
            end
        end
    end
    _G.LibrarySystem.BookShapes = bookShapes
    return bookShapes
end

local function SolvePassword()
    local shapeOrder = _G.LibrarySystem.ShapeOrder
    local bookShapes = _G.LibrarySystem.BookShapes
    
    if #shapeOrder == 0 or not next(bookShapes) then
        LibraryStatusLabel:Set("❌ Şifre çözülemedi")
        return ""
    end
    
    local password = ""
    for _, shape in pairs(shapeOrder) do
        if bookShapes[shape] then
            password = password .. tostring(bookShapes[shape])
        end
    end
    
    _G.LibrarySystem.FinalPassword = password
    LibraryStatusLabel:Set("✅ Şifre: " .. password)
    return password
end

