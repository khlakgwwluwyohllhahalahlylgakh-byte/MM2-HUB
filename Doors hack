-- Şifre Çöz
local function SolvePassword()
    local shapeOrder = _G.LibrarySystem.ShapeOrder
    local bookShapes = _G.LibrarySystem.BookShapes
    
    if #shapeOrder == 0 or not next(bookShapes) then
        Log("Şifre çözme başarısız: Eksik veri")
        LibraryStatusLabel:Set("❌ Şifre çözülemedi")
        return ""
    end
    
    local password = ""
    
    -- Kağıttaki şekil sırasına göre kitaplardan sayıları al
    for _, shape in pairs(shapeOrder) do
        if bookShapes[shape] then
            password = password .. tostring(bookShapes[shape])
        else
            Log("Uyarı: " .. shape .. " şekli bulunamadı")
        end
    end
    
    Log("✅ Şifre çözüldü: " .. password)
    _G.LibrarySystem.FinalPassword = password
    LibraryStatusLabel:Set("✅ Şifre: " .. password)
    
    return password
end

