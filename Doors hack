                -- Seek'ten uzaklaş
                local entity = _G.GameState.ActiveEntity
                if entity then
                    local entityPos = GetEntityPosition(entity)
                    if entityPos then
                        -- Ters yöne koş
                        local escapeDir = (hrp.Position - entityPos).Unit
                        local escapePos = hrp.Position + escapeDir * 100
                        
                        WalkToTarget(escapePos, 30, 5)
                    end
                end
                
                _G.Statistics.EntitiesAvoided = _G.Statistics.EntitiesAvoided + 1
                goto continue
            end
            
            -- [DURUM 2]: RUSH KAÇIŞI
            if _G.Settings.RushDetection and DetectRush() then
                Log("⚡ RUSH UYARISI! TEZDEN GİT!", "THREAT")
                
                humanoid.WalkSpeed = _G.Settings.SprintSpeed
                local door = room:FindFirstChild("Door")
                if door then
                    local doorPart = door:FindFirstChildWhichIsA("BasePart")
                    if doorPart then
                        WalkToTarget(doorPart.Position, 15, 3)
                    end
                end
                
                _G.Statistics.EntitiesAvoided = _G.Statistics.EntitiesAvoided + 1
                goto continue
            end
            
            -- [DURUM 3]: AMBUSH KAÇIŞI
            if _G.Settings.AmbushDetection and DetectAmbush() then
                Log("🎭 AMBUSH SALDIRISI! SAKLANILIYOR...", "THREAT")
                
                HideInCloset(room, hrp)
                
                _G.Statistics.EntitiesAvoided = _G.Statistics.EntitiesAvoided + 1
                goto continue
            end
            
            -- [DURUM 4]: KÜTÜPHANE ODA (50)
            if room.Name == "50" then
                SolveLibrary(room)
                goto continue
            end
            
            -- [DURUM 5]: NORMAL ODA İŞLEMİ
            humanoid.WalkSpeed = _G.Settings.WalkSpeed
            
            -- Anahtar al
            PickupKey(room)
            
            -- Sonraki kapıyı bul
            local nextDoor = FindNextDoor(room, hrp)
            if nextDoor then
                local doorPart = nextDoor:FindFirstChildWhichIsA("BasePart")
                if doorPart then
                    -- Kapıya git
                    WalkToTarget(doorPart.Position, 10, 2)
                    task.wait(0.1)
                    
                    -- Kilit kontrol et
                    local lock = nextDoor:FindFirstChild("Lock")
                    if lock and not HasKey() then
                        Log("🔓 Anahtar gerekli, bulunmuyor!", "WARNING")
                    elseif lock and HasKey() then
                        -- Kilit aç
                        local lockPrompt = lock:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if lockPrompt then
                            local keyTool = LocalPlayer.Backpack:FindFirstChild("Key")
                            if keyTool then
                                humanoid:EquipTool(keyTool)
                                task.wait(0.1)
                            end
                            
                            SafeExecute(function()
                                if lockPrompt.TriggerPrompt then
                                    lockPrompt:TriggerPrompt()
                                else
                                    fireproximityprompt(lockPrompt)
                                end
                            end, "UnlockDoor")
                            
                            task.wait(0.2)
                        end
                    end
                    
                    -- Kapıyı aç
                    local doorPrompt = doorPart.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if doorPrompt then
                        SafeExecute(function()
                            if doorPrompt.TriggerPrompt then
                                doorPrompt:TriggerPrompt()
                            else
                                fireproximityprompt(doorPrompt)
                            end
                        end, "OpenDoor")
                    end
                    
                    _G.Statistics.DoorsOpened = _G.Statistics.DoorsOpened + 1
                    task.wait(0.5)
                end
            end
            
        end, "MainGameLoop")
        
        ::continue::
    end
end)

