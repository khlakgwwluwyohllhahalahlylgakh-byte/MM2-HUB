-- 5. DÜNYA VE META KONTROLÜ (WORLD TAB)
--------------------------------------------------------------------------------

TabWorld:CreateSection("Kaynak Yönetimi ve Hava Kontrolü")

TabWorld:CreateButton({
    Name = "🪵 Haritadaki Tüm Odun, Kütük ve Scrap'leri Ateşe Yığ",
    Callback = function()
        pcall(function()
            local campfirePos = nil
            for _, obj in pairs(Workspace:GetDescendants()) do
                if (obj.Name:lower():find("campfire") or obj.Name:lower():find("fire")) and obj:IsA("BasePart") then
                    campfirePos = obj.Position
                    break
                end
            end
            if not campfirePos then campfirePos = LocalPlayer.Character.HumanoidRootPart.Position end

            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name:lower():find("wood") or obj.Name:lower():find("log") or obj.Name:lower():find("scrap")) then
                    obj.CFrame = CFrame.new(campfirePos + Vector3.new(math.random(-3, 3), 1, math.random(-3, 3)))
                end
            end
        end)
        Rayfield:Notify({Title = "Kaynaklar Taşındı", Content = "Tüm odunlar ve scrap malzemeleri ateşe yığıldı!", Duration = 3})
    end,
})

TabWorld:CreateToggle({
    Name = "Sisi Kaldır & Full Gece Görüşü (Fullbright)",
    CurrentValue = false,
    Callback = function(Value)
        pcall(function()
            if Value then
                Workspace.CurrentCamera.FieldOfView = 95
                Lighting.Brightness = 3
                Lighting.ClockTime = 14
                for _, v in pairs(Lighting:GetChildren()) do
                    if v:IsA("Atmosphere") or v:IsA("Fog") then v.Parent = nil end
                end
            else
                Lighting.Brightness = 1
                Lighting.ClockTime = 0
            end
        end)
    end,
})

TabWorld:CreateToggle({
    Name = "Süper Koşma Hızı (WalkSpeed 48)",
    CurrentValue = false,
    Callback = function(Value)
        _G.SuperSpeed = Value
        task.spawn(function()
            while _G.SuperSpeed do
                task.wait(0.1)
                pcall(function()
                    LocalPlayer.Character.Humanoid.WalkSpeed = 48
                end)
            end
            pcall(function()
                LocalPlayer.Character.Humanoid.WalkSpeed = 16
            end)
        end)
    end,
})

Rayfield:LoadConfiguration()

