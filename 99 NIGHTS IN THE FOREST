-- 4. ESP VE GÖRÜŞ SİSTEMLERİ (ESP TAB)
--------------------------------------------------------------------------------

TabEsp:CreateSection("Varlık ve Tehdit Takibi")

TabEsp:CreateToggle({
    Name = "Canavar & Deer (Geyik) ESP (Kırmızı Vurgu)",
    CurrentValue = false,
    Callback = function(Value)
        _G.MobESP = Value
        task.spawn(function()
            while _G.MobESP do
                task.wait(1)
                pcall(function()
                    for _, obj in pairs(Workspace:GetChildren()) do
                        if obj:FindFirstChild("Humanoid") and obj ~= LocalPlayer.Character then
                            if not obj:FindFirstChild("Highlight") then
                                local hl = Instance.new("Highlight", obj)
                                hl.FillColor = Color3.fromRGB(255, 0, 0)
                                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            end
                        end
                    end
                end)
            end
        end)
    end,
})

TabEsp:CreateToggle({
    Name = "Kayıp Çocuklar ESP (Yeşil Vurgu)",
    CurrentValue = false,
    Callback = function(Value)
        _G.KidESP = Value
        task.spawn(function()
            while _G.KidESP do
                task.wait(1)
                pcall(function()
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj.Name:lower():find("child") or obj.Name:lower():find("kid") then
                            if not obj:FindFirstChild("Highlight") then
                                local hl = Instance.new("Highlight", obj)
                                hl.FillColor = Color3.fromRGB(0, 255, 0)
                                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
