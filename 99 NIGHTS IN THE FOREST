-- 🧹 GÜVENLİ TEMİZLİK (FULL CLEANUP)
-- ==========================================================
local function FullCleanup()
    _G.AutoMaxFire = false
    _G.GodStats = false
    _G.GodMode = false
    _G.MegaAura = false
    _G.Hitbox = false
    _G.MobESP = false
    _G.KidESP = false
    _G.SuperSpeed = false

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "Highlight" and (obj.Parent and (obj.Parent:FindFirstChild("Humanoid") or obj.Name:lower():find("child") or obj.Name:lower():find("kid"))) then
            obj:Destroy()
        end
    end

    pcall(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = 16
        end
    end)
end

