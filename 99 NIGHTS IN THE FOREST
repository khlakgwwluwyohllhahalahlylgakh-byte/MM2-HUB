-- 1. KAMP ATEŞİ VE İSTATİSTİKLER (CAMP & STATS TAB)
--------------------------------------------------------------------------------

TabCamp:CreateSection("Kamp Ateşi Otomasyonu (Max Ateş)")

TabCamp:CreateToggle({
    Name = "Kamp Ateşini Sürekli Max/Full Tut (Auto-Max Campfire)",
    CurrentValue = false,
    Callback = function(Value)
        _G.AutoMaxFire = Value
        isCheatActive = Value
        if ActiveWidget then ActiveWidget.Visible = Value end
        task.spawn(function()
            while _G.AutoMaxFire do
                task.wait(0.3)
                pcall(function()
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj.Name:lower():find("campfire") or obj.Name:lower():find("fire") then
                            if obj:FindFirstChild("Fuel") then obj.Fuel.Value = 99999 end
                            if obj:FindFirstChild("Health") then obj.Health.Value = obj.MaxHealth.Value end
                            for _, child in pairs(obj:GetDescendants()) do
                                if child:IsA("RemoteEvent") then child:FireServer("Feed", 9999) end
                            end
                        end
                    end
                end)
            end
        end)
    end,
})

TabCamp:CreateSection("Hayatta Kalma İstatistikleri (God Stats)")

TabCamp:CreateToggle({
    Name = "Sınırsız Açlık, Susuzluk & Sanity (Sabitleme)",
    CurrentValue = false,
    Callback = function(Value)
        _G.GodStats = Value
        isCheatActive = Value
        if ActiveWidget then ActiveWidget.Visible = Value end
        task.spawn(function()
            while _G.GodStats do
                task.wait(0.1)
                pcall(function()
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("Humanoid") then
                        char.Humanoid.Health = char.Humanoid.MaxHealth
                    end
                    if LocalPlayer:FindFirstChild("PlayerStats") then
                        if LocalPlayer.PlayerStats:FindFirstChild("Hunger") then LocalPlayer.PlayerStats.Hunger.Value = 100 end
                        if LocalPlayer.PlayerStats:FindFirstChild("Thirst") then LocalPlayer.PlayerStats.Thirst.Value = 100 end
                        if LocalPlayer.PlayerStats:FindFirstChild("Sanity") then LocalPlayer.PlayerStats.Sanity.Value = 100 end
                    end
                end)
            end
        end)
    end,
})

--------------------------------------------------------------------------------
-- 2. ÇOCUK KURTARMA VE SANDIK OTOMASYONU (RESCUE TAB)
--------------------------------------------------------------------------------

TabRescue:CreateSection("Kayıp Çocuk Kurtarma (Dino, Kraken, Squid, Koala)")

TabRescue:CreateButton({
    Name = "👶 Tüm Kayıp Çocukları Kamp Ateşine Işınla",
    Callback = function()
        pcall(function()
            local campfirePos = nil
            for _, obj in pairs(Workspace:GetDescendants()) do
                if (obj.Name:lower():find("campfire") or obj.Name:lower():find("fire")) and obj:IsA("BasePart") then
                    campfirePos = obj.Position
                    break
                end
            end
            if not campfirePos then campfirePos = LocalPlayer.Character.HumanoidRootPart.Position end

            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj.Name:lower():find("child") or obj.Name:lower():find("kid") then
                    if obj:FindFirstChild("HumanoidRootPart") then
                        obj.HumanoidRootPart.CFrame = CFrame.new(campfirePos + Vector3.new(math.random(-3, 3), 2, math.random(-3, 3)))
                    elseif obj:IsA("Model") and obj.PrimaryPart then
                        obj:SetPrimaryPartCFrame(CFrame.new(campfirePos + Vector3.new(math.random(-3, 3), 2, math.random(-3, 3))))
                    end
                end
            end
        end)
        Rayfield:Notify({Title = "Başarılı", Content = "Bütün kayıp çocuklar kamp ateşinin yanına çekildi!", Duration = 3})
    end,
})

TabRescue:CreateSection("Sandık ve Loot Toplama Zinciri")

TabRescue:CreateButton({
    Name = "📦 Tüm Sandıkları (Ruby, Iron, Common) Yanına Çek & Otomatik Aç",
    Callback = function()
        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj.Name:lower():find("chest") or obj.Name:lower():find("box") or obj.Name:lower():find("loot") then
                    if obj:IsA("Model") and obj.PrimaryPart then
                        obj:SetPrimaryPartCFrame(hrp.CFrame + Vector3.new(math.random(-4, 4), 1, math.random(-4, 4)))
                    elseif obj:IsA("BasePart") then
                        obj.CFrame = hrp.CFrame + Vector3.new(math.random(-4, 4), 1, math.random(-4, 4))
                    end
                    
                    for _, child in pairs(obj:GetDescendants()) do
                        if child:IsA("ProximityPrompt") then
                            fireproximityprompt(child)
                        elseif child:IsA("RemoteEvent") then
                            child:FireServer()
                        end
                    end
                end
            end
        end)
        Rayfield:Notify({Title = "Loot Toplandı", Content = "Tüm sandıklar ayağına getirildi ve açıldı!", Duration = 3})
    end,
})

